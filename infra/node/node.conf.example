# Configuração do nó (/etc/verax/node.conf). Nada aqui é segredo: as senhas ficam no Secret Manager (de fora) ou são
# geradas na VM pelo install.sh (de dentro). Exemplo com valores fictícios; o arquivo real fica só na VM.
VERAX_GCP_PROJECT=projeto-do-no
# Prefixo dos cofres: o name_prefix do ambiente do Terraform (infra/gcp/envs/<ambiente>). Com ele e com o projeto, o
# start.sh monta o tópico do sink de projeto de cliente que o painel mostra; os dois seguem o formato do módulo.
VERAX_SECRET_PREFIX=verax-node
IMAGES_REPOSITORY=us-east1-docker.pkg.dev/projeto-do-no/verax-control
WEB_ORIGIN=https://cliente.control.exemplo.com.br
API_ORIGIN=https://api-cliente.exemplo.com.br
# E-mail opcional: contas nascem com senha temporária. Com MAIL_TRANSPORT=smtp, a redefinição de senha pelo link
# também funciona (a senha da caixa fica no cofre `<prefixo>-smtp-password`).
MAIL_TRANSPORT=none
MAIL_FROM=nao-responda@exemplo.com.br
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=465
# SMTP_USER=nao-responda@exemplo.com.br
# Fontes do worker. O nó da Verax (perfil lean, sem Wazuh) lê só a GCP: SYNC_SOURCES=gcp, sem nenhuma variável do
# indexer. O nó de cliente (perfil standard, com o Wazuh no nó) lê também as contas AWS pelo indexer local:
# SYNC_SOURCES=gcp,wazuh. A credencial do indexer (INDEXER_AUTH=node) não fica aqui: com o Wazuh no nó (PR-W1), o
# start.sh a escreve no ambiente da API e do worker a partir dos segredos gerados na VM, com a CA do volume dos
# certificados do Wazuh. Sem isso, o worker com `wazuh` nas fontes não sobe.
SYNC_SOURCES=gcp
BACKUP_BUCKET=projeto-do-no-verax-node-backups
# Plano do nó: essencial, profissional, enterprise ou interno (o nó da própria Verax, sem limite). Os ajustes trocam um
# limite do plano (extras contratados); no enterprise, os quatro são obrigatórios; no interno, nenhum é aceito.
PLAN=interno
# PLAN_MAX_CLOUD_ACCOUNTS=3
# PLAN_MAX_USERS=5
# PLAN_MONTHLY_GIB=15
# PLAN_HISTORY_DAYS=90
# Perfil do nó: lean (o da Verax: e2-micro, sem Wazuh) ou standard (nó de cliente: e2-standard-2, com o Wazuh). Define a
# memória do banco, da API e do worker e, no standard, sobe também o Wazuh (infra/node/compose.wazuh.yaml); o mesmo
# perfil do Terraform (node_profile). Sem a linha, vale lean.
NODE_PROFILE=lean
# IP de saída do nó com /32 (`terraform output nat_ip` no perfil standard), separados por vírgula: é o IP que a política
# IAM da AWS do cliente libera. Vazio no nó da Verax, que sai pelo IP automático do NAT.
NODE_EGRESS_IPS=
# NODE_EGRESS_IPS=203.0.113.10/32
