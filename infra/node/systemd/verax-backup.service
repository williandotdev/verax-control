# Wants, e não Requires: o backup roda mesmo com o verax-node em falha (o banco pode estar no ar; se não estiver, o
# backup.sh falha sozinho, com o motivo no journal), em vez de parar em "dependency failed" sem dizer nada.
[Unit]
Description=Verax Control - backup do banco no bucket
Wants=verax-node.service
After=verax-node.service

[Service]
Type=oneshot
ExecStart=/opt/verax/bin/backup.sh
