# A cada minuto, como o intervalo do worker que lê a lista (SYNC_INTERVAL_SECONDS=60). Começa 2 min depois do boot, com
# o Wazuh já subindo.
[Unit]
Description=Verax Control - lista dos agentes do Wazuh a cada minuto

[Timer]
OnBootSec=2min
OnUnitActiveSec=60s
AccuracySec=10s

[Install]
WantedBy=timers.target
