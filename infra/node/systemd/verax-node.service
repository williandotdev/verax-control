# Nó do Verax Control: banco, papéis e migrations, API, worker e túnel do Cloudflare (infra/node/compose.yaml).
[Unit]
Description=Verax Control - no (banco, API, worker e tunel)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/verax/bin/start.sh up
ExecStop=/opt/verax/bin/start.sh down
# Acima da soma das esperas do start.sh no perfil standard (indexer até 10 min e manager até 15 min, mais a primeira
# descarga das imagens do Wazuh): se o systemd matasse a partida no meio de uma espera, o nó ficaria pela metade.
TimeoutStartSec=2400

[Install]
WantedBy=multi-user.target
