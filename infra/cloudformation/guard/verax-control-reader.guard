#
# Regras do cfn-guard para o papel de leitura (verax-control-reader.yaml), conferidas no template como ele é, com os
# Fn::If e os Ref. É uma segunda leitura, com outra ferramenta, das garantias que tests/test_reader.py confere com a
# pilha montada: nenhum usuário nem chave e nada com cara de segredo, só o nó do Verax Control entra no papel (só o
# Google, só a troca do token, com aud, sub, oaud e o IP do nó exatos), papel preso ao limite de permissões, negação de
# fora do IP do nó, leitura só com verbos de leitura e, do modelo 2, as três autorizações do cliente: cada uma é um
# parâmetro true/false, as declarações dela só existem com ele ligado e são exatamente as esperadas (os objetos só em
# AWSLogs/<esta conta>/, a listagem só dessas pastas e do primeiro nível, o Decrypt só pelo S3, os grupos de log só com
# a etiqueta do cliente), e as etiquetas do papel dizem o modelo e o que foi autorizado. Fora dessas declarações, o
# conteúdo de log nunca fica em "*". A única escrita, opcional e desligada por padrão (EnableAlbAccessLogs), é o
# ModifyLoadBalancerAttributes dos ALB da região, numa declaração exata. Os casos de verax-control-reader.tests.yaml
# conferem as regras.
#

let papeis = Resources.*[ Type == 'AWS::IAM::Role' ]
let politicas = Resources.*[ Type == 'AWS::IAM::ManagedPolicy' ]
let negacoes = Resources.*[
    Type == 'AWS::IAM::ManagedPolicy'
    Properties.ManagedPolicyName == 'VeraxControlGuardrails'
]
let leitura = Resources.*[
    Type == 'AWS::IAM::ManagedPolicy'
    Properties.ManagedPolicyName == 'VeraxControlReader'
]
let segredo = /(?i)(secret|password|senha|token|credential|accesskey)/
# As declarações das três autorizações do cliente (os Sids) e as ações que leem conteúdo: objetos, listagem de bucket,
# Decrypt, eventos de log e achados.
let da_autorizacao = /^(LerLogsDaAwsDestaConta|ListarLogsDaAwsDestaConta|VerPrimeiroNivelDosBuckets|DecifrarLogsDaAwsSoPeloS3|LerAchadosDeSeguranca|LerGruposDeLogEtiquetados)$/
let conteudo = /^(s3:GetObject|s3:ListBucket|kms:Decrypt|logs:DescribeLogStreams|logs:FilterLogEvents|logs:GetLogEvents|guardduty:GetFindings|guardduty:ListFindings|securityhub:GetFindings|securityhub:GetEnabledStandards|inspector2:ListFindings|inspector2:ListCoverage|access-analyzer:GetFinding|access-analyzer:ListFindings)$/

# Nenhum usuário, chave, senha ou grupo: o nó entra no papel com um token do Google, e a pilha não tem credencial de
# longa duração. As políticas da pilha também não se penduram num usuário ou num grupo que já exista.
rule sem_usuario_nem_chave {
    Resources.*[
        Type in [
            'AWS::IAM::User',
            'AWS::IAM::AccessKey',
            'AWS::IAM::ServiceSpecificCredential',
            'AWS::IAM::UserPolicy',
            'AWS::IAM::UserToGroupAddition',
            'AWS::IAM::Group',
            'AWS::IAM::GroupPolicy'
        ]
    ] empty
    when %politicas !empty {
        %politicas {
            Properties.Users !exists
            Properties.Groups !exists
        }
    }
}

# Nenhuma saída nem parâmetro com cara de segredo: a pilha não tem segredo nenhum. O GetAtt vem como lista ou, na
# forma curta, como texto com ponto; o nome da saída também conta.
rule nenhuma_saida_com_segredo {
    Outputs !empty
    Outputs[ keys == %segredo ] empty
    Outputs.* {
        Value.'Fn::GetAtt' !exists or Value.'Fn::GetAtt' != %segredo
        Value.'Fn::Sub' !exists or Value.'Fn::Sub' != %segredo
        Value.Ref !exists or Value.Ref != %segredo
    }
    when Parameters exists {
        Parameters.*[ NoEcho exists ] empty
    }
}

# Um papel só, com nome e caminho fixos (o ARN sai só do ID da conta), sessão de 1 hora, sem política em linha, com o
# limite de permissões da política de leitura e só as duas políticas da pilha, que não se anexam a nenhum outro papel.
rule papel_preso_ao_limite {
    %papeis !empty
    %papeis {
        Properties.RoleName == 'verax-control-reader'
        Properties.Path == '/verax/'
        Properties.MaxSessionDuration == 3600
        Properties.Policies !exists
        Properties.PermissionsBoundary.Ref == 'ReaderPolicy'
        Properties.ManagedPolicyArns == [ { 'Ref': 'ReaderPolicy' }, { 'Ref': 'GuardrailsPolicy' } ]
    }
    when %politicas !empty {
        %politicas {
            Properties.Roles !exists
        }
    }
}

# Só o Google entra, e só pela troca do token: nenhum outro provedor, nenhum usuário, papel, conta ou serviço da AWS,
# nenhum AssumeRole comum, e nada de NotPrincipal ou NotAction (que inverteriam o sentido da declaração).
rule confianca_so_do_google {
    %papeis !empty
    let confianca = %papeis.Properties.AssumeRolePolicyDocument.Statement[*]
    %confianca !empty
    %confianca {
        Effect == 'Allow'
        NotPrincipal !exists
        NotAction !exists
        Principal == { 'Federated': 'accounts.google.com' }
        Action == 'sts:AssumeRoleWithWebIdentity'
    }
}

# Toda declaração da confiança tem as quatro condições, exatas e só elas: aud, sub e oaud em StringEquals, com os
# valores dos parâmetros validados (aud e sub, o ID único da conta de serviço do nó; oaud, o audience do Verax
# Control), e o IP de saída do nó em IpAddress. A condição inteira é comparada: nenhum StringLike, curinga ou valor
# fixo, nenhuma chave a menos ou a mais e nenhum outro operador passa.
rule confianca_amarrada_ao_no {
    %papeis !empty
    let confianca = %papeis.Properties.AssumeRolePolicyDocument.Statement[*]
    %confianca !empty
    %confianca {
        Condition == {
            'StringEquals': {
                'accounts.google.com:aud': { 'Ref': 'NodeServiceAccountId' },
                'accounts.google.com:sub': { 'Ref': 'NodeServiceAccountId' },
                'accounts.google.com:oaud': { 'Ref': 'Audience' }
            },
            'IpAddress': { 'aws:SourceIp': { 'Fn::Split': [ ',', { 'Ref': 'NodeEgressIps' } ] } }
        }
    }
}

# Toda chamada feita direto com a sessão, de fora do IP do nó, é negada. A única exceção é a chamada que um serviço da
# AWS faz em nome do papel (aws:ViaAWSService; o S3 pedindo ao KMS o objeto que o nó leu), como a AWS documenta para a
# negação por IP. A condição inteira é comparada, para que nenhum outro operador (que estreitaria a negação) nem outra
# chave ao lado do aws:SourceIp e do aws:ViaAWSService passe.
rule nega_fora_do_ip_do_no {
    %negacoes !empty
    some %negacoes.Properties.PolicyDocument.Statement[*] {
        Sid == 'SoDoNoDaVerax'
        Effect == 'Deny'
        Action == '*'
        Resource == '*'
        NotAction !exists
        NotResource !exists
        Condition == {
            'NotIpAddress': { 'aws:SourceIp': { 'Fn::Split': [ ',', { 'Ref': 'NodeEgressIps' } ] } },
            'Bool': { 'aws:ViaAWSService': 'false' }
        }
    }
}

# A política de leitura só libera verbos de leitura (mais a simulação do próprio papel, o Decrypt pelo S3 e a leitura
# dos eventos de log). A leitura das etiquetas e a simulação valem só para o próprio papel, numa declaração só.
rule leitura_so_le {
    %leitura !empty
    let declaracoes = %leitura.Properties.PolicyDocument.Statement[ Effect exists ]
    let condicionais = %leitura.Properties.PolicyDocument.Statement[ 'Fn::If' exists ].'Fn::If'[1]
    %declaracoes {
        Effect == 'Allow'
        NotAction !exists
        NotResource !exists
        Action == /^[a-z0-9-]+:(Get|List|Describe|BatchGet|Search|SimulatePrincipalPolicy$|Decrypt$|FilterLogEvents$)/
    }
    %condicionais[ Sid != 'LigarLogDosAlb' ] {
        Effect == 'Allow'
        NotAction !exists
        NotResource !exists
        Action == /^[a-z0-9-]+:(Get|List|Describe|BatchGet|Search|SimulatePrincipalPolicy$|Decrypt$|FilterLogEvents$)/
        Action != /^iam:(GetRole|SimulatePrincipalPolicy)$/
    }
    %declaracoes[ Sid != 'AutoInspecao' ] {
        Action != /^iam:(GetRole|SimulatePrincipalPolicy)$/
    }
    %declaracoes[ Sid == 'AutoInspecao' ] {
        Resource == { 'Fn::Sub': 'arn:${AWS::Partition}:iam::${AWS::AccountId}:role/verax/verax-control-reader' }
        Condition !exists
    }
}

# O conteúdo (objetos, listagem de bucket, Decrypt, eventos de log e achados) só existe nas declarações condicionais,
# que dependem de o cliente autorizar, informar ou pedir a fonte (a ação em texto ou em lista). Fora das declarações
# das três autorizações (cada uma conferida inteira, na regra dela, abaixo), nenhum recurso, em texto ou em lista, é "*",
# um curinga de bucket (antes da primeira /) ou um curinga de chave (qualquer * num ARN do KMS), e nenhuma lê evento de
# log ou achado; o Decrypt só vale pelo S3, em todas.
rule conteudo_so_nos_recursos_informados {
    %leitura !empty
    let declaracoes = %leitura.Properties.PolicyDocument.Statement[ Effect exists ]
    let condicionais = %leitura.Properties.PolicyDocument.Statement[ 'Fn::If' exists ].'Fn::If'[1]
    let curinga = /(^\*$|^arn:[^:]*:s3:[^\/]*\*|^arn:[^:]*:kms:.*\*)/
    %declaracoes {
        Action != %conteudo
    }
    %condicionais[ Sid != %da_autorizacao ] {
        Resource exists
        NotResource !exists
        Action != /^(logs|guardduty|securityhub|inspector2|access-analyzer):/
        when Resource is_string {
            Resource != %curinga
        }
        when Resource is_list {
            Resource[*] {
                this !is_string or this != %curinga
            }
        }
    }
    %condicionais[ Action == 'kms:Decrypt' or some Action[*] == 'kms:Decrypt' ] {
        Condition.*.'kms:ViaService' exists
    }
}

# As três autorizações do cliente são interruptores: cada uma é um parâmetro true/false, ligado por padrão, e uma
# condição que é só ele igual a true. As declarações de cada uma ficam sob a condição dela (e nada mais fica), e nenhuma
# existe fora de um Fn::If: desligado o parâmetro, a permissão não é criada.
rule autorizacoes_sao_interruptores {
    Parameters.ReadAwsServiceLogs.AllowedValues == [ 'true', 'false' ]
    Parameters.ReadAwsServiceLogs.Default == 'true'
    Parameters.ReadSecurityFindings.AllowedValues == [ 'true', 'false' ]
    Parameters.ReadSecurityFindings.Default == 'true'
    Parameters.ReadTaggedLogGroups.AllowedValues == [ 'true', 'false' ]
    Parameters.ReadTaggedLogGroups.Default == 'true'
    Conditions.ReadsServiceLogs == { 'Fn::Equals': [ { 'Ref': 'ReadAwsServiceLogs' }, 'true' ] }
    Conditions.ReadsFindings == { 'Fn::Equals': [ { 'Ref': 'ReadSecurityFindings' }, 'true' ] }
    Conditions.ReadsLogGroups == { 'Fn::Equals': [ { 'Ref': 'ReadTaggedLogGroups' }, 'true' ] }

    %leitura !empty
    let declaracoes = %leitura.Properties.PolicyDocument.Statement[ Effect exists ]
    let condicionadas = %leitura.Properties.PolicyDocument.Statement[ 'Fn::If' exists ]
    %declaracoes {
        Sid != %da_autorizacao
    }
    %condicionadas[ 'Fn::If'[1].Sid == /^(LerLogsDaAwsDestaConta|ListarLogsDaAwsDestaConta|VerPrimeiroNivelDosBuckets|DecifrarLogsDaAwsSoPeloS3)$/ ] {
        'Fn::If'[0] == 'ReadsServiceLogs'
    }
    %condicionadas[ 'Fn::If'[1].Sid == 'LerAchadosDeSeguranca' ] {
        'Fn::If'[0] == 'ReadsFindings'
    }
    %condicionadas[ 'Fn::If'[1].Sid == 'LerGruposDeLogEtiquetados' ] {
        'Fn::If'[0] == 'ReadsLogGroups'
    }
    %condicionadas[ 'Fn::If'[0] == /^(ReadsServiceLogs|ReadsFindings|ReadsLogGroups)$/ ] {
        'Fn::If'[1].Sid == %da_autorizacao
        'Fn::If'[2] == { 'Ref': 'AWS::NoValue' }
    }
}

# Logs da AWS no S3: o papel lê só os objetos em AWSLogs/<esta conta>/ e, na trilha de organização, em
# AWSLogs/o-<organização>/<esta conta>/, de qualquer bucket. O recurso inteiro é comparado: sem o ID da conta, com outro
# prefixo ou com uma condição a mais, não passa.
rule objetos_so_em_awslogs_desta_conta {
    %leitura !empty
    let condicionais = %leitura.Properties.PolicyDocument.Statement[ 'Fn::If' exists ].'Fn::If'[1]
    let declaracao = %condicionais[ Sid == 'LerLogsDaAwsDestaConta' ]
    %declaracao !empty
    %declaracao {
        Effect == 'Allow'
        Action == 's3:GetObject'
        Resource == [
            { 'Fn::Sub': 'arn:${AWS::Partition}:s3:::*/AWSLogs/${AWS::AccountId}/*' },
            { 'Fn::Sub': 'arn:${AWS::Partition}:s3:::*/AWSLogs/o-*/${AWS::AccountId}/*' }
        ]
        Condition !exists
    }
}

# A listagem dessas mesmas pastas: só com um prefixo dentro delas (a condição inteira é comparada). A terceira é a
# pasta desta conta atrás de um prefixo, que o GetObject de cima já alcança (o log do ALB com prefixo).
rule listagem_so_das_pastas_desta_conta {
    %leitura !empty
    let condicionais = %leitura.Properties.PolicyDocument.Statement[ 'Fn::If' exists ].'Fn::If'[1]
    let declaracao = %condicionais[ Sid == 'ListarLogsDaAwsDestaConta' ]
    %declaracao !empty
    %declaracao {
        Effect == 'Allow'
        Action == 's3:ListBucket'
        Resource == { 'Fn::Sub': 'arn:${AWS::Partition}:s3:::*' }
        Condition == {
            'StringLike': {
                's3:prefix': [
                    { 'Fn::Sub': 'AWSLogs/${AWS::AccountId}/*' },
                    { 'Fn::Sub': 'AWSLogs/o-*/${AWS::AccountId}/*' },
                    { 'Fn::Sub': '*/AWSLogs/${AWS::AccountId}/*' }
                ]
            }
        }
    }
}

# O primeiro nível de um bucket e o da pasta AWSLogs: só com o separador "/" e só com esses três prefixos. Sem o
# separador, a mesma listagem desceria o bucket inteiro.
rule primeiro_nivel_so_com_o_separador {
    %leitura !empty
    let condicionais = %leitura.Properties.PolicyDocument.Statement[ 'Fn::If' exists ].'Fn::If'[1]
    let declaracao = %condicionais[ Sid == 'VerPrimeiroNivelDosBuckets' ]
    %declaracao !empty
    %declaracao {
        Effect == 'Allow'
        Action == 's3:ListBucket'
        Resource == { 'Fn::Sub': 'arn:${AWS::Partition}:s3:::*' }
        Condition == { 'StringEquals': { 's3:delimiter': '/', 's3:prefix': [ '', 'AWSLogs', 'AWSLogs/' ] } }
    }
}

# O Decrypt dos logs da AWS vale para qualquer chave, mas só quando quem pede é o S3 em nome do papel.
rule decrypt_dos_logs_so_pelo_s3 {
    %leitura !empty
    let condicionais = %leitura.Properties.PolicyDocument.Statement[ 'Fn::If' exists ].'Fn::If'[1]
    let declaracao = %condicionais[ Sid == 'DecifrarLogsDaAwsSoPeloS3' ]
    %declaracao !empty
    %declaracao {
        Effect == 'Allow'
        Action == 'kms:Decrypt'
        Resource == '*'
        Condition == { 'StringLike': { 'kms:ViaService': 's3.*.amazonaws.com' } }
    }
}

# Os achados de segurança: só estas oito leituras, e nenhuma ação que ative um serviço ou altere um achado.
rule achados_so_com_leitura {
    %leitura !empty
    let condicionais = %leitura.Properties.PolicyDocument.Statement[ 'Fn::If' exists ].'Fn::If'[1]
    let declaracao = %condicionais[ Sid == 'LerAchadosDeSeguranca' ]
    %declaracao !empty
    %declaracao {
        Effect == 'Allow'
        Resource == '*'
        Action == [
            'access-analyzer:GetFinding',
            'access-analyzer:ListFindings',
            'guardduty:GetFindings',
            'guardduty:ListFindings',
            'inspector2:ListCoverage',
            'inspector2:ListFindings',
            'securityhub:GetEnabledStandards',
            'securityhub:GetFindings'
        ]
    }
}

# Os eventos do CloudWatch Logs: só dos grupos de log desta conta com a etiqueta verax-control = leitura, que o cliente
# põe e tira. O recurso e a condição inteiros são comparados: sem a etiqueta, com curinga ou com outra ação, não passa.
rule grupos_de_log_so_com_a_etiqueta {
    %leitura !empty
    let condicionais = %leitura.Properties.PolicyDocument.Statement[ 'Fn::If' exists ].'Fn::If'[1]
    let declaracao = %condicionais[ Sid == 'LerGruposDeLogEtiquetados' ]
    %declaracao !empty
    %declaracao {
        Effect == 'Allow'
        Action == [ 'logs:DescribeLogStreams', 'logs:FilterLogEvents', 'logs:GetLogEvents' ]
        Resource == [
            { 'Fn::Sub': 'arn:${AWS::Partition}:logs:*:${AWS::AccountId}:log-group:*' },
            { 'Fn::Sub': 'arn:${AWS::Partition}:logs:*:${AWS::AccountId}:log-group:*:*' }
        ]
        Condition == { 'StringEquals': { 'aws:ResourceTag/verax-control': 'leitura' } }
    }
}

# As etiquetas do papel: a versão do modelo e o que foi autorizado, com a descoberta sempre e cada autorização só com
# a condição dela. Separadas por espaço: o IAM recusa vírgula no valor de uma etiqueta.
rule etiquetas_do_papel {
    %papeis !empty
    %papeis {
        Properties.Tags == [
            { 'Key': 'verax-control:template', 'Value': '3' },
            {
                'Key': 'verax-control:capabilities',
                'Value': {
                    'Fn::Join': [
                        '',
                        [
                            'discovery',
                            { 'Fn::If': [ 'ReadsServiceLogs', ' service-logs', '' ] },
                            { 'Fn::If': [ 'ReadsFindings', ' findings', '' ] },
                            { 'Fn::If': [ 'ReadsLogGroups', ' log-groups', '' ] }
                        ]
                    ]
                }
            },
            {
                'Fn::If': [
                    'ManagesAlbLogs',
                    {
                        'Key': 'verax-control:alb-logs-bucket',
                        'Value': { 'Fn::Sub': '${AWS::Region}/${AlbLogsBucket}' }
                    },
                    { 'Ref': 'AWS::NoValue' }
                ]
            }
        ]
    }
}

# A única escrita do papel: só com EnableAlbAccessLogs (um parâmetro true/false, desligado por padrão), o
# ModifyLoadBalancerAttributes dos ALB desta região e desta conta, numa declaração exata e sob a condição dele. Nenhuma
# outra declaração da leitura tem Modify do balanceador.
rule escrita_do_alb_exata {
    Parameters.EnableAlbAccessLogs.AllowedValues == [ 'true', 'false' ]
    Parameters.EnableAlbAccessLogs.Default == 'false'
    Conditions.ManagesAlbLogs == { 'Fn::Equals': [ { 'Ref': 'EnableAlbAccessLogs' }, 'true' ] }

    %leitura !empty
    let declaracoes = %leitura.Properties.PolicyDocument.Statement[ Effect exists ]
    let condicionadas = %leitura.Properties.PolicyDocument.Statement[ 'Fn::If' exists ]
    let escrita = %condicionadas[ 'Fn::If'[1].Sid == 'LigarLogDosAlb' ]
    %declaracoes {
        Sid != 'LigarLogDosAlb'
        Action != /^elasticloadbalancing:Modify/
    }
    %escrita !empty
    %escrita {
        'Fn::If'[0] == 'ManagesAlbLogs'
        'Fn::If'[1] == {
            'Sid': 'LigarLogDosAlb',
            'Effect': 'Allow',
            'Action': 'elasticloadbalancing:ModifyLoadBalancerAttributes',
            'Resource': {
                'Fn::Sub': 'arn:${AWS::Partition}:elasticloadbalancing:${AWS::Region}:${AWS::AccountId}:loadbalancer/app/*'
            }
        }
        'Fn::If'[2] == { 'Ref': 'AWS::NoValue' }
    }
    %condicionadas[ 'Fn::If'[1].Sid != 'LigarLogDosAlb' ] {
        'Fn::If'[1].Action != /^elasticloadbalancing:Modify/
    }
}

# O WAF nunca é alterado e o GuardDuty nunca é ativado pela pilha.
rule waf_e_guardduty_intocados {
    Resources.*[ Type == /^AWS::WAF/ ] empty
    Resources.*[ Type == 'AWS::GuardDuty::Detector' ] empty
}
