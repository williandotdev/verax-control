{
  "AssumeRolePolicyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "SoONoDaVerax",
        "Effect": "Allow",
        "Principal": {
          "Federated": "accounts.google.com"
        },
        "Action": "sts:AssumeRoleWithWebIdentity",
        "Condition": {
          "StringEquals": {
            "accounts.google.com:aud": "123456789012345678901",
            "accounts.google.com:sub": "123456789012345678901",
            "accounts.google.com:oaud": "https://control.veraxsistemas.com.br/aws-reader"
          },
          "IpAddress": {
            "aws:SourceIp": ["203.0.113.10/32"]
          }
        }
      }
    ]
  },
  "VeraxControlReader": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AutoInspecao",
        "Effect": "Allow",
        "Action": ["iam:GetRole", "iam:SimulatePrincipalPolicy"],
        "Resource": "arn:aws:iam::111111111111:role/verax/verax-control-reader"
      },
      {
        "Sid": "ValidarFontes",
        "Effect": "Allow",
        "Resource": "*",
        "Action": [
          "cloudtrail:DescribeTrails",
          "cloudtrail:GetTrailStatus",
          "guardduty:ListDetectors",
          "guardduty:GetDetector",
          "guardduty:ListPublishingDestinations",
          "guardduty:DescribePublishingDestination"
        ]
      },
      {
        "Sid": "PosturaEAtivos",
        "Effect": "Allow",
        "Resource": "*",
        "Action": [
          "iam:GetAccountSummary",
          "iam:GetAccountPasswordPolicy",
          "iam:ListUsers",
          "iam:ListAccessKeys",
          "iam:GetAccessKeyLastUsed",
          "iam:ListMFADevices",
          "iam:GetLoginProfile",
          "ec2:DescribeRegions",
          "ec2:DescribeInstances",
          "ec2:DescribeSecurityGroups",
          "ec2:GetEbsEncryptionByDefault",
          "s3:ListAllMyBuckets",
          "s3:GetBucketAcl",
          "s3:GetBucketPolicyStatus",
          "s3:GetBucketPublicAccessBlock",
          "s3:GetAccountPublicAccessBlock"
        ]
      },
      {
        "Sid": "DescobrirFontes",
        "Effect": "Allow",
        "Resource": "*",
        "Action": [
          "access-analyzer:ListAnalyzers",
          "cloudtrail:GetEventSelectors",
          "config:DescribeConfigurationRecorders",
          "config:DescribeConfigurationRecorderStatus",
          "config:DescribeDeliveryChannels",
          "ec2:DescribeFlowLogs",
          "ec2:DescribeVpcs",
          "elasticloadbalancing:DescribeLoadBalancers",
          "elasticloadbalancing:DescribeLoadBalancerAttributes",
          "inspector2:BatchGetAccountStatus",
          "logs:DescribeLogGroups",
          "logs:ListTagsForResource",
          "rds:DescribeDBInstances",
          "rds:DescribeDBClusters",
          "s3:GetBucketLocation",
          "s3:GetEncryptionConfiguration",
          "securityhub:DescribeHub",
          "wafv2:GetLoggingConfiguration",
          "wafv2:ListLoggingConfigurations",
          "wafv2:ListWebACLs"
        ]
      },
      {
        "Sid": "LerLogsDaAwsDestaConta",
        "Effect": "Allow",
        "Action": "s3:GetObject",
        "Resource": ["arn:aws:s3:::*/AWSLogs/111111111111/*", "arn:aws:s3:::*/AWSLogs/o-*/111111111111/*"]
      },
      {
        "Sid": "ListarLogsDaAwsDestaConta",
        "Effect": "Allow",
        "Action": "s3:ListBucket",
        "Resource": "arn:aws:s3:::*",
        "Condition": {
          "StringLike": {
            "s3:prefix": ["AWSLogs/111111111111/*", "AWSLogs/o-*/111111111111/*", "*/AWSLogs/111111111111/*"]
          }
        }
      },
      {
        "Sid": "VerPrimeiroNivelDosBuckets",
        "Effect": "Allow",
        "Action": "s3:ListBucket",
        "Resource": "arn:aws:s3:::*",
        "Condition": {
          "StringEquals": {
            "s3:delimiter": "/",
            "s3:prefix": ["", "AWSLogs", "AWSLogs/"]
          }
        }
      },
      {
        "Sid": "DecifrarLogsDaAwsSoPeloS3",
        "Effect": "Allow",
        "Action": "kms:Decrypt",
        "Resource": "*",
        "Condition": {
          "StringLike": {
            "kms:ViaService": "s3.*.amazonaws.com"
          }
        }
      },
      {
        "Sid": "LerAchadosDeSeguranca",
        "Effect": "Allow",
        "Resource": "*",
        "Action": [
          "access-analyzer:GetFinding",
          "access-analyzer:ListFindings",
          "guardduty:GetFindings",
          "guardduty:ListFindings",
          "inspector2:ListCoverage",
          "inspector2:ListFindings",
          "securityhub:GetEnabledStandards",
          "securityhub:GetFindings"
        ]
      },
      {
        "Sid": "LerGruposDeLogEtiquetados",
        "Effect": "Allow",
        "Action": ["logs:DescribeLogStreams", "logs:FilterLogEvents", "logs:GetLogEvents"],
        "Resource": ["arn:aws:logs:*:111111111111:log-group:*", "arn:aws:logs:*:111111111111:log-group:*:*"],
        "Condition": {
          "StringEquals": {
            "aws:ResourceTag/verax-control": "leitura"
          }
        }
      },
      {
        "Sid": "ListarBucketsDeLog",
        "Effect": "Allow",
        "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
        "Resource": [
          "arn:aws:s3:::trilha-111111111111",
          "arn:aws:s3:::guardduty-111111111111",
          "arn:aws:s3:::aws-waf-logs-111111111111"
        ]
      },
      {
        "Sid": "LerObjetosDeLog",
        "Effect": "Allow",
        "Action": "s3:GetObject",
        "Resource": [
          "arn:aws:s3:::trilha-111111111111/*",
          "arn:aws:s3:::guardduty-111111111111/*",
          "arn:aws:s3:::aws-waf-logs-111111111111/*"
        ]
      }
    ]
  },
  "VeraxControlGuardrails": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "SoDoNoDaVerax",
        "Effect": "Deny",
        "Action": "*",
        "Resource": "*",
        "Condition": {
          "NotIpAddress": {
            "aws:SourceIp": ["203.0.113.10/32"]
          },
          "Bool": {
            "aws:ViaAWSService": "false"
          }
        }
      },
      {
        "Sid": "NuncaAlterarLogs",
        "Effect": "Deny",
        "Resource": "*",
        "Action": [
          "access-analyzer:Delete*",
          "access-analyzer:Update*",
          "cloudtrail:Create*",
          "cloudtrail:Delete*",
          "cloudtrail:Put*",
          "cloudtrail:Stop*",
          "cloudtrail:Update*",
          "guardduty:Archive*",
          "guardduty:Create*",
          "guardduty:Delete*",
          "guardduty:Disable*",
          "guardduty:Disassociate*",
          "guardduty:Update*",
          "inspector2:Delete*",
          "inspector2:Disable*",
          "inspector2:Update*",
          "kms:Delete*",
          "kms:Disable*",
          "kms:Put*",
          "kms:ScheduleKeyDeletion",
          "kms:Update*",
          "logs:Associate*",
          "logs:Create*",
          "logs:Delete*",
          "logs:Disassociate*",
          "logs:Put*",
          "logs:Tag*",
          "logs:Unmask",
          "logs:Untag*",
          "logs:Update*",
          "s3:Abort*",
          "s3:Bypass*",
          "s3:Create*",
          "s3:Delete*",
          "s3:Put*",
          "s3:Replicate*",
          "s3:Restore*",
          "s3:Update*",
          "securityhub:BatchImport*",
          "securityhub:BatchUpdate*",
          "securityhub:Delete*",
          "securityhub:Disable*",
          "securityhub:Update*",
          "wafv2:Delete*",
          "wafv2:Put*",
          "wafv2:Update*"
        ]
      },
      {
        "Sid": "NuncaAlterarOutrasFontes",
        "Effect": "Deny",
        "Resource": "*",
        "Action": [
          "access-analyzer:Apply*",
          "access-analyzer:Cancel*",
          "access-analyzer:Create*",
          "access-analyzer:Start*",
          "access-analyzer:Tag*",
          "access-analyzer:Untag*",
          "config:Delete*",
          "config:Put*",
          "config:Start*",
          "config:Stop*",
          "ec2:CreateFlowLogs",
          "ec2:DeleteFlowLogs",
          "elasticloadbalancing:Modify*",
          "inspector2:Associate*",
          "inspector2:BatchUpdate*",
          "inspector2:Cancel*",
          "inspector2:Create*",
          "inspector2:Disassociate*",
          "inspector2:Enable*",
          "inspector2:Reset*",
          "inspector2:Send*",
          "inspector2:Start*",
          "inspector2:Stop*",
          "inspector2:Tag*",
          "inspector2:Untag*",
          "securityhub:Accept*",
          "securityhub:BatchDelete*",
          "securityhub:BatchDisable*",
          "securityhub:BatchEnable*",
          "securityhub:Create*",
          "securityhub:Decline*",
          "securityhub:Disassociate*",
          "securityhub:Enable*",
          "securityhub:Invite*",
          "securityhub:Start*",
          "securityhub:Tag*",
          "securityhub:Untag*",
          "wafv2:Associate*",
          "wafv2:Create*",
          "wafv2:Disassociate*",
          "wafv2:Tag*",
          "wafv2:Untag*"
        ]
      },
      {
        "Sid": "NuncaTrocarAsPropriasEtiquetas",
        "Effect": "Deny",
        "Resource": "*",
        "Action": ["iam:Tag*", "iam:Untag*"]
      },
      {
        "Sid": "NuncaAmpliarOProprioAcesso",
        "Effect": "Deny",
        "Resource": "*",
        "Action": [
          "iam:Add*",
          "iam:Attach*",
          "iam:Create*",
          "iam:Delete*",
          "iam:Detach*",
          "iam:PassRole",
          "iam:Put*",
          "iam:Remove*",
          "iam:Set*",
          "iam:Update*",
          "iam:Upload*",
          "sts:AssumeRole",
          "sts:AssumeRoleWithSAML",
          "sts:AssumeRoleWithWebIdentity",
          "sts:GetFederationToken"
        ]
      }
    ]
  }
}
