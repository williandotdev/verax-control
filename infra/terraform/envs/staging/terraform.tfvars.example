# Copie para terraform.tfvars (fora do git) e preencha o e-mail que recebe os alarmes.
# O DNS de veraxsistemas.com.br fica no Cloudflare: sem dns_zone_id, os registros são criados à mão
# (roteiro na seção "DNS no Cloudflare" do README do Terraform).
panel_domain = "staging.control.veraxsistemas.com.br"
api_domain   = "api.staging.control.veraxsistemas.com.br"
# Domínio de e-mail diferente do de produção: cada ambiente verifica a própria identidade no SES.
mail_from = "nao-responda@staging.control.veraxsistemas.com.br"
# alarm_email = "e-mail que recebe os alarmes"
