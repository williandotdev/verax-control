# Copie para `terraform.tfvars` (que o git ignora) e preencha. Nada daqui vai para o repositório.

# ID do projeto da GCP onde o nó fica (aparece no seletor de projetos do console).
project_id = "meu-projeto-123"

# Projetos cujos logs de segurança vão para o nó (pode incluir o próprio projeto do nó).
monitored_projects = ["meu-projeto-123"]

# Região e zona do nó. us-east1 tem a e2-micro e o disco do nível gratuito.
# region = "us-east1"
# zone   = "us-east1-b"

# Quem pode entrar na VM por SSH, além do dono do projeto.
# operators = ["user:voce@exemplo.com"]

# Alerta de orçamento: conta de faturamento e valor mensal, na moeda dela. O nó da Verax já tem o orçamento no estado:
# sem `billing_account_id`, o `plan` apaga o alerta (veja o GUIA, passo 3).
# billing_account_id = "000000-000000-000000"
# monthly_budget     = 50
