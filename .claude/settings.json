{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/.dev-mailbox/**)",
      "Read(./**/*.tfstate)",
      "Read(./**/terraform.tfvars)",
      "Read(./**/*.auto.tfvars)"
    ]
  }
}
