{
  "name": "@verax/web",
  "version": "0.0.0",
  "private": true,
  "description": "Front do Verax Control (React + Vite)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build && node ../../scripts/scan-bundle.mjs dist",
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build:demo": "tsc -p tsconfig.json --noEmit && vite build --mode mock && node ../../scripts/scan-bundle.mjs dist",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:fullstack": "playwright test -c playwright.fullstack.config.ts",
    "test:e2e:sites": "playwright test -c playwright.sites.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "@verax/shared": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.66.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-qr-code": "2.2.0",
    "react-router": "8.5.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
