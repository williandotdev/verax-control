# Plano de controle: modelo de configuração para desenvolvimento local (copie para apps/control-plane/.env).
# Em produção nada disto vem de arquivo: variáveis do serviço no Cloud Run e segredos do Secret Manager montados
# como variáveis. A lista completa, com o formato de cada uma, está em src/common/config/env.schema.ts.

# Papel (obrigatório): public (checkout, webhook, status) ou worker (passos internos).
ROLE=public
NODE_ENV=development
LOG_LEVEL=debug
PORT=8080
# Proxies confiáveis na frente do serviço (Hosting + Cloud Run = 1 em produção; 0 em local).
TRUST_PROXY_HOPS=0

# Estado: Firestore. Em local, o emulador (apps/control-plane/scripts/firestore-emulator.sh start).
FIRESTORE_DATABASE=(default)
FIRESTORE_PROJECT_ID=demo-verax-cp
FIRESTORE_EMULATOR_HOST=127.0.0.1:8681

# Checkout (CP-03): site e Stripe. Sem o grupo inteiro o serviço sobe, avisa no log quais faltam e o checkout
# responde 503 (a consulta de subdomínio funciona). As versões têm de ser as das páginas publicadas no site; os
# links do aceite saem da origem de SITE_SUCCESS_URL (/termos, /privacidade, /dpa). A chave é a restrita de teste do
# sandbox (rk_test_...), lida do Secret Manager em produção; aqui, só em .env, que o git ignora. STRIPE_LIVE=false
# recusa chave de produção na partida.
# SITE_ORIGINS=https://veraxsistemas.com.br,https://www.veraxsistemas.com.br
# SITE_SUCCESS_URL=https://veraxsistemas.com.br/checkout/sucesso?cs={CHECKOUT_SESSION_ID}
# SITE_CANCEL_URL=https://veraxsistemas.com.br/#planos
# TERMS_VERSION=2026-11-04
# PRIVACY_VERSION=2026-11-04
# DPA_VERSION=2026-11-04
# STRIPE_LIVE=false
# STRIPE_SECRET_KEY=rk_test_coloque-aqui-a-chave-do-sandbox
# STRIPE_PRICE_LOOKUP_ESSENCIAL=verax_control_essencial_mensal
# STRIPE_PRICE_LOOKUP_PROFISSIONAL=verax_control_profissional_mensal

# Webhook da Stripe (CP-04, só o papel public): sem o segredo de assinatura (e a chave acima) o webhook responde 503
# sem ler nada. Em local, `stripe listen --forward-to localhost:8080/v1/stripe/webhook` imprime um segredo whsec_...
# próprio da sessão do CLI: ponha-o aqui (o .env não vai para o git). Em produção vem de cp-stripe-webhook-secret.
# STRIPE_WEBHOOK_SECRET=whsec_coloque-aqui-o-segredo-do-stripe-listen

# Fila de passos no Cloud Tasks (CP-04): o webhook enfileira o `preflight` quando o cliente entra em provisioning.
# Sem o grupo inteiro o serviço sobe e avisa quais faltam; o webhook que precisar enfileirar responde 500 (a Stripe
# repete). Em produção o Terraform deriva todas (run.tf). Em local não há emulador do Cloud Tasks: deixe comentado, ou
# aponte para uma fila de teste num projeto seu (com as credenciais padrão do gcloud).
# TASKS_PROJECT_ID=demo-verax-cp
# TASKS_LOCATION=southamerica-east1
# TASKS_QUEUE_PROVISIONING=provisioning
# TASKS_QUEUE_LIFECYCLE=lifecycle
# WORKER_URL=https://cp-worker-000000000000.southamerica-east1.run.app
# WORKER_SA_EMAIL=cp-invoker@demo-verax-cp.iam.gserviceaccount.com

# Provisionamento (CP-07), Cloudflare e Firebase (CP-07), acesso e e-mail (CP-05): opcionais até cada PR passar a
# exigi-los. Exemplo:
# PROVISIONING_ENABLED=false
