{
  "name": "@verax/api",
  "version": "0.0.0",
  "private": true,
  "description": "API do Verax Control (NestJS)",
  "type": "module",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "predev": "prisma generate",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "pretest": "prisma generate",
    "test": "vitest run",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "nest build && node dist/cli/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1161.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@verax/shared": "workspace:*",
    "better-auth": "1.7.14",
    "cookie-parser": "1.4.7",
    "csrf-csrf": "4.0.3",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.20",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
