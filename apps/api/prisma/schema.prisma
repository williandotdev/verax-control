// Schema do banco da API (PostgreSQL 18).
// A URL de conexão fica em prisma.config.ts (Prisma 7) e vem sempre do ambiente, nunca do código.
// Modelos com dado de cliente terão `tenantId` e entram na extensão de isolamento (T2.5).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Quem executou a ação registrada na auditoria.
enum AuditActorType {
  user
  system
  anonymous
}

/// Resultado da operação auditada.
enum AuditOutcome {
  success
  failure
  denied
}

/// Trilha de auditoria imutável (T1.3): só INSERT. Um trigger no banco bloqueia UPDATE, DELETE e TRUNCATE.
/// Os IDs de ator e cliente não têm chave estrangeira de propósito: o registro sobrevive à exclusão do
/// usuário ou do cliente.
model AuditLog {
  id           String         @id @default(uuid(7)) @db.Uuid
  occurredAt   DateTime       @default(now()) @db.Timestamptz(3)
  actorType    AuditActorType
  actorId      String?
  tenantId     String?
  action       String         @db.VarChar(200)
  resourceType String?        @db.VarChar(100)
  resourceId   String?        @db.VarChar(200)
  outcome      AuditOutcome
  statusCode   Int?           @db.SmallInt
  before       Json?
  after        Json?
  ip           String?        @db.VarChar(64)
  userAgent    String?        @db.VarChar(256)
  requestId    String?        @db.VarChar(64)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@index([requestId])
}

/// Papéis do painel (T2.4). `admin_verax` é da Verax e não pertence a cliente; os demais pertencem a um.
enum UserRole {
  admin_verax
  admin_cliente
  analista_cliente
  leitura
}

/// Usuário só entra por convite (T2.6): nasce `invited`, vira `active` ao definir a senha.
enum UserStatus {
  invited
  active
  disabled
}

enum TenantStatus {
  active
  inactive
}

/// Cliente da Verax (T3.1). CNPJ, plano e contato são obrigatórios na API; ficam opcionais no banco só por
/// causa dos clientes criados antes do cadastro completo.
model Tenant {
  id              String       @id @default(uuid(7)) @db.Uuid
  name            String       @db.VarChar(120)
  /// 14 caracteres, sem máscara (numérico ou alfanumérico).
  cnpj            String?      @unique @db.VarChar(14)
  plan            String?      @db.VarChar(60)
  escalationName  String?      @db.VarChar(120)
  escalationEmail String?      @db.VarChar(254)
  escalationPhone String?      @db.VarChar(20)
  status          TenantStatus @default(active)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  users           User[]
  /// Sessões de admin_verax com este cliente selecionado (T2.5).
  activeSessions  Session[]
}

// ---------------------------------------------------------------------------------------------------
// Tabelas do Better Auth (T2.1). Nomes e campos seguem o que a biblioteca espera; `role`, `tenantId` e
// `status` são campos adicionais que o usuário não consegue alterar pela API de autenticação.
// ---------------------------------------------------------------------------------------------------

model User {
  id               String         @id
  name             String         @db.VarChar(120)
  email            String         @unique @db.VarChar(254)
  emailVerified    Boolean        @default(false)
  image            String?
  role             UserRole
  tenantId         String?        @db.Uuid
  tenant           Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  status           UserStatus     @default(invited)
  /// MFA (T2.2): sem ele, a sessão só alcança o cadastro do próprio MFA.
  twoFactorEnabled Boolean        @default(false)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  usedTotpCodes    UsedTotpCode[]

  @@index([tenantId])
}

model Session {
  id             String   @id
  token          String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime @db.Timestamptz(3)
  ipAddress      String?  @db.VarChar(64)
  userAgent      String?  @db.VarChar(512)
  /// Cliente selecionado por um admin_verax (T2.5). Só muda por POST /v1/session/tenant, auditado.
  activeTenantId String?  @db.Uuid
  activeTenant   Tenant?  @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  /// Hash da senha (scrypt, gerado pelo Better Auth). Nunca a senha em si.
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

/// Tokens de convite e de redefinição de senha, guardados com hash (`storeIdentifier: "hashed"`).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

/// TOTP e códigos de recuperação (T2.2). O segredo e os códigos ficam cifrados com a chave do Better Auth.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
}

/// Limite de requisições por IP das rotas de autenticação (T2.3), no banco para valer entre instâncias.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

/// Tentativas de login por e-mail que ainda não terminaram numa sessão completa (T2.3). Vale também para
/// e-mail inexistente, para não revelar quem existe.
model LoginAttempt {
  email          String    @id @db.VarChar(254)
  failures       Int
  firstFailureAt DateTime  @db.Timestamptz(3)
  lockedUntil    DateTime? @db.Timestamptz(3)
}

/// Códigos TOTP aceitos em login nos últimos minutos (T2.2): o mesmo código não abre uma segunda sessão.
model UsedTotpCode {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code   String   @db.VarChar(16)
  usedAt DateTime @db.Timestamptz(3)

  @@id([userId, code])
}
