// Schema do banco da API (PostgreSQL 18).
// A URL de conexão fica em prisma.config.ts (Prisma 7) e vem sempre do ambiente, nunca do código.
// Modelos com dado de cliente terão `tenantId` e entram na extensão de isolamento (T2.5).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Quem executou a ação registrada na auditoria.
enum AuditActorType {
  user
  system
  anonymous
}

/// Resultado da operação auditada.
enum AuditOutcome {
  success
  failure
  denied
}

/// Trilha de auditoria imutável (T1.3): só INSERT. Um trigger no banco bloqueia UPDATE, DELETE e TRUNCATE.
/// A única exceção é o expurgo diário (fase 2, PR-19): o DELETE de registro com mais de 13 meses, só pela função
/// `verax_purge_audit_log` (migration `20261109120000_history_retention`). O papel da aplicação não tem DELETE.
/// Os IDs de ator e cliente não têm chave estrangeira de propósito: o registro sobrevive à exclusão do
/// usuário ou do cliente.
model AuditLog {
  id           String         @id @default(uuid(7)) @db.Uuid
  occurredAt   DateTime       @default(now()) @db.Timestamptz(3)
  actorType    AuditActorType
  actorId      String?
  tenantId     String?
  action       String         @db.VarChar(200)
  resourceType String?        @db.VarChar(100)
  resourceId   String?        @db.VarChar(200)
  outcome      AuditOutcome
  statusCode   Int?           @db.SmallInt
  before       Json?
  after        Json?
  ip           String?        @db.VarChar(64)
  userAgent    String?        @db.VarChar(256)
  requestId    String?        @db.VarChar(64)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@index([requestId])
  /// Expurgo pela idade, em todos os registros (os sem cliente não usam o índice por cliente).
  @@index([occurredAt])
}

/// Papéis do painel (T2.4). `admin_verax` é da Verax e não pertence a cliente; os demais pertencem a um.
enum UserRole {
  admin_verax
  admin_cliente
  analista_cliente
  leitura
}

/// Usuário só entra por convite (T2.6): nasce `invited`, vira `active` ao definir a senha.
enum UserStatus {
  invited
  active
  disabled
}

enum TenantStatus {
  active
  inactive
}

/// Cliente da Verax (T3.1). CNPJ, plano e contato são obrigatórios na API; ficam opcionais no banco só por
/// causa dos clientes criados antes do cadastro completo.
model Tenant {
  id                 String              @id @default(uuid(7)) @db.Uuid
  name               String              @db.VarChar(120)
  /// 14 caracteres, sem máscara (numérico ou alfanumérico).
  cnpj               String?             @unique @db.VarChar(14)
  plan               String?             @db.VarChar(60)
  escalationName     String?             @db.VarChar(120)
  escalationEmail    String?             @db.VarChar(254)
  escalationPhone    String?             @db.VarChar(20)
  status             TenantStatus        @default(active)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  users              User[]
  cloudAccounts      CloudAccount[]
  protectedResources ProtectedResource[]
  alertExceptions    AlertException[]
  findings           Finding[]
  findingComments    FindingComment[]
  incidents          Incident[]
  postureScans       PostureScan[]
  postureFailures    PostureFailure[]
  inventorySnapshots InventorySnapshot[]
  ingestUsage        IngestUsage[]
  cloudCredentials   CloudCredential[]
  wazuhAgents        WazuhAgent[]
  notifications      Notification[]
  /// Sessões de admin_verax com este cliente selecionado (T2.5).
  activeSessions     Session[]
}

// ---------------------------------------------------------------------------------------------------
// Tabelas do Better Auth (T2.1). Nomes e campos seguem o que a biblioteca espera; `role`, `tenantId` e
// `status` são campos adicionais que o usuário não consegue alterar pela API de autenticação.
// ---------------------------------------------------------------------------------------------------

model User {
  id                         String              @id
  name                       String              @db.VarChar(120)
  email                      String              @unique @db.VarChar(254)
  emailVerified              Boolean             @default(false)
  image                      String?
  role                       UserRole
  tenantId                   String?             @db.Uuid
  tenant                     Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  status                     UserStatus          @default(invited)
  /// MFA (T2.2): sem ele, a sessão só alcança o cadastro do próprio MFA.
  twoFactorEnabled           Boolean             @default(false)
  /// Senha temporária (criada pelo administrador): a sessão só alcança a troca de senha até a pessoa definir a dela.
  mustChangePassword         Boolean             @default(false)
  /// Validade da senha temporária: depois disso, o login com ela não abre sessão.
  temporaryPasswordExpiresAt DateTime?           @db.Timestamptz(3)
  createdAt                  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime            @updatedAt @db.Timestamptz(3)
  sessions                   Session[]
  accounts                   Account[]
  twoFactors                 TwoFactor[]
  usedTotpCodes              UsedTotpCode[]
  protectedResources         ProtectedResource[]
  alertExceptions            AlertException[]
  findingComments            FindingComment[]
  assignedIncidents          Incident[]

  @@index([tenantId])
}

model Session {
  id             String   @id
  token          String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime @db.Timestamptz(3)
  ipAddress      String?  @db.VarChar(64)
  userAgent      String?  @db.VarChar(512)
  /// Cliente selecionado por um admin_verax (T2.5). Só muda por POST /v1/session/tenant, auditado.
  activeTenantId String?  @db.Uuid
  activeTenant   Tenant?  @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  /// Hash da senha (scrypt, gerado pelo Better Auth). Nunca a senha em si.
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

/// Tokens de convite e de redefinição de senha, guardados com hash (`storeIdentifier: "hashed"`).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

/// TOTP e códigos de recuperação (T2.2). O segredo e os códigos ficam cifrados com a chave do Better Auth.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
}

/// Limite de requisições por IP das rotas de autenticação (T2.3), no banco para valer entre instâncias.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

/// Tentativas de login por e-mail que ainda não terminaram numa sessão completa (T2.3). Vale também para
/// e-mail inexistente, para não revelar quem existe.
model LoginAttempt {
  email          String    @id @db.VarChar(254)
  failures       Int
  firstFailureAt DateTime  @db.Timestamptz(3)
  lockedUntil    DateTime? @db.Timestamptz(3)
}

/// Códigos TOTP aceitos em login nos últimos minutos (T2.2): o mesmo código não abre uma segunda sessão.
model UsedTotpCode {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code   String   @db.VarChar(16)
  usedAt DateTime @db.Timestamptz(3)

  @@id([userId, code])
}

enum CloudAccountStatus {
  active
  inactive
}

enum CloudProvider {
  aws
  gcp
  cloudflare
}

/// Estado da coleta de uma conta: `waiting` até o primeiro sinal de vida, `connected` depois dele e `error` quando a
/// última leitura da fonte falhou. O sinal depende do provedor: na AWS (Wazuh) e na GCP (Pub/Sub), que entregam por
/// evento, é o evento recebido; nos coletados por API (Cloudflare), basta a leitura bem-sucedida.
enum CloudAccountConnection {
  waiting
  connected
  error
}

/// Conta cloud de um cliente (T3.3): conta AWS, projeto da GCP ou conta do Cloudflare. Nenhuma credencial fica no
/// cadastro: na AWS, o nó entra no papel de leitura sem chave da conta (`/verax/verax-control-reader`, derivado do ID)
/// com o token que o Google assina para a conta de serviço dele; na GCP, o nó lê com a identidade dele, sem chave. Só
/// o token do Cloudflare fica cifrado à parte, em `CloudCredential` (cofre do nó). Cada conta pertence a um só cliente.
model CloudAccount {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  tenantId           String                 @db.Uuid
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  provider           CloudProvider          @default(aws)
  /// 12 dígitos (AWS), ID do projeto (GCP, até 30) ou 32 hexadecimais (Cloudflare).
  accountId          String                 @db.VarChar(32)
  /// AWS: regiões monitoradas.
  regions            String[]
  /// Obsoleto (o ExternalId do conector antigo): a API não lê nem grava desde o PR-V3', e a migration dele apagou os
  /// valores. A coluna fica só para a versão anterior da API, numa volta de versão, encontrar o que ela lê; sai numa
  /// migration de contração.
  externalId         String?                @db.VarChar(128)
  /// AWS: buckets de onde o Wazuh lê os logs desta conta (T5.2 vincula cada alerta pelo bucket de origem).
  cloudtrailBucket   String?                @db.VarChar(63)
  guarddutyBucket    String?                @db.VarChar(63)
  wafBucket          String?                @db.VarChar(63)
  /// GCP: assinatura do Pub/Sub que o nó lê, pelo nome completo (`projects/<projeto>/subscriptions/<id>`).
  pubsubSubscription String?                @db.VarChar(320)
  /// GCP, projeto de cliente: identidade de escrita do sink que o cliente criou no projeto dele, colada no painel
  /// (`serviceAccount:service-<número>@gcp-sa-logging.iam.gserviceaccount.com`). Não é segredo: é a quem o Terraform
  /// do nó deixa publicar no tópico do projeto.
  sinkWriterIdentity String?                @db.VarChar(128)
  /// Cloudflare: zonas (domínios) monitoradas.
  zones              String[]               @default([])
  /// Horário do alerta mais recente desta conta, gravado pelo sync (T5.3).
  lastEventAt        DateTime?              @db.Timestamptz(3)
  /// Estado da coleta, gravado pelo sync da conta (ver `CloudAccountConnection`).
  connection         CloudAccountConnection @default(waiting)
  /// Tipo do último erro de coleta (o nome da classe do erro). Nunca a mensagem, que pode carregar dado ou segredo.
  connectionError    String?                @db.VarChar(64)
  /// AWS: aviso da coleta pelo Wazuh do nó (`aws_token_stale` ou `wazuh_apply_failed`, PR-V4'), à parte da conexão:
  /// só a tarefa `wazuh-config` do worker o grava, e a conferência da conexão (`aws-check`) só grava `connectionError`.
  /// Só conta AWS, e só os códigos da coleta (CHECK da migration).
  collectionError    String?                @db.VarChar(64)
  /// Última leitura bem-sucedida da fonte desta conta, com ou sem evento. Só vale como sinal de vida na Torre nos
  /// provedores coletados por API (Cloudflare); na AWS e na GCP, o sinal é o evento.
  lastCollectedAt    DateTime?              @db.Timestamptz(3)
  /// AWS: "Verificar" pedido no painel e ainda não respondido pela tarefa `aws-check` do worker, que confere a entrada
  /// no papel e a leitura dos buckets e grava a conexão (`src/aws/aws-check.ts`). Null sem pedido pendente. A
  /// migration confere por CHECK que só conta AWS tem o pedido.
  checkRequestedAt   DateTime?              @db.Timestamptz(3)
  /// AWS: dia a partir do qual o Wazuh lê os logs dos buckets (`only_logs_after`): o da primeira verificação
  /// bem-sucedida, menos um dia. Gravado uma vez só, pelo worker; sem ele, o Wazuh leria todo o histórico do bucket.
  /// Só conta AWS (CHECK da migration).
  ingestFrom         DateTime?              @db.Date
  status             CloudAccountStatus     @default(active)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
  cursors            CollectorCursor[]
  credential         CloudCredential?

  @@unique([provider, accountId])
  /// Alvo da chave estrangeira composta da `CloudCredential`: a credencial é sempre do mesmo cliente da conta.
  @@unique([id, tenantId])
  @@index([tenantId])
}

/// Cursor de um coletor (fase 2): até onde cada fluxo de cada conta já foi lido e quando ler de novo. Um por conta,
/// fluxo e região. Dado de sistema, sem `tenantId` de propósito: o cliente da sessão nem alcança o model (o escopo
/// recusa), e o estado que o cliente vê fica na `CloudAccount` (`connection`, `lastCollectedAt`).
model CollectorCursor {
  id             String       @id @default(uuid(7)) @db.Uuid
  cloudAccountId String       @db.Uuid
  cloudAccount   CloudAccount @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)
  /// Fluxo lido, como `aws_cloudtrail` ou `cloudflare_audit`.
  stream         String       @db.VarChar(32)
  /// Região da AWS; vazio nos fluxos sem região.
  region         String       @default("") @db.VarChar(32)
  /// Horário do evento mais recente já processado. Só anda para a frente; null antes da primeira leitura.
  cursorAt       DateTime?    @db.Timestamptz(3)
  /// Continuação opaca da fonte (NextToken, cursor da API) quando a execução parou no teto de páginas.
  continuation   String?      @db.VarChar(2048)
  /// Próxima leitura: o intervalo do fluxo depois de um sucesso, o recuo depois de uma falha.
  nextRunAt      DateTime     @default(now()) @db.Timestamptz(3)
  lastSuccessAt  DateTime?    @db.Timestamptz(3)
  /// Tipo do último erro, sem mensagem.
  lastErrorKind  String?      @db.VarChar(64)
  /// Falhas seguidas desde o último sucesso; definem o recuo.
  failures       Int          @default(0)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([cloudAccountId, stream, region])
  @@index([stream, nextRunAt])
}

enum ProtectedResourceType {
  aws_account
  iam_user
  iam_role
  access_key
  ec2_instance
  s3_bucket
  security_group
  ip_address
}

/// Lista de proteção (T3.4): recursos e identidades que nunca recebem ação automática.
model ProtectedResource {
  id          String                @id @default(uuid(7)) @db.Uuid
  tenantId    String                @db.Uuid
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  type        ProtectedResourceType
  identifier  String                @db.VarChar(600)
  reason      String                @db.VarChar(500)
  createdById String
  createdBy   User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, type, identifier])
}

enum AlertExceptionField {
  user
  ip
  resource
}

/// Exceção de alerta (T3.5): o sync marca como esperado o achado da regra cujo campo bate com o valor.
model AlertException {
  id            String              @id @default(uuid(7)) @db.Uuid
  tenantId      String              @db.Uuid
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ruleId        String              @db.VarChar(6)
  field         AlertExceptionField
  value         String              @db.VarChar(256)
  reason        String              @db.VarChar(500)
  expiresAt     DateTime?           @db.Timestamptz(3)
  /// Quantas vezes a exceção marcou um achado como esperado (atualizado pelo sync, T5.3).
  matchedCount  Int                 @default(0)
  lastMatchedAt DateTime?           @db.Timestamptz(3)
  createdById   String
  createdBy     User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)
  findings      Finding[]

  @@unique([tenantId, ruleId, field, value])
}

enum FindingSeverity {
  critical
  high
  medium
  low
}

enum FindingStatus {
  new
  investigating
  legitimate
  resolved
}

/// Achado (T5.3 a T5.5): alerta do Wazuh já vinculado a um cliente pela T5.2. Aqui ficam os campos que o painel
/// mostra e os estados humanos (status e comentários); o evento bruto continua no indexer e só vem no detalhe.
/// `(source, sourceEventId)` é único: o sync relê uma janela de sobreposição sem duplicar achados.
model Finding {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @db.Uuid
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// Conta do provedor de onde veio o evento (12 dígitos, ID do projeto ou ID do Cloudflare).
  accountId       String           @db.VarChar(32)
  /// Sistema de origem do alerta (`wazuh` ou `gcp`).
  source          String           @db.VarChar(16)
  /// Chave do achado na origem, a mesma a cada releitura do evento (no Wazuh, `wazuh/<conta>/<tipo>:<id>:<regra>`).
  sourceEventId   String           @db.VarChar(128)
  /// Só no Wazuh: ID do alerta da primeira leitura, por onde o detalhe busca o evento bruto no indexer.
  rawEventId      String?          @db.VarChar(128)
  /// Fonte de log: `cloudtrail`, `guardduty`, `waf`.
  logSource       String           @db.VarChar(32)
  occurredAt      DateTime         @db.Timestamptz(3)
  severity        FindingSeverity
  status          FindingStatus    @default(new)
  ruleId          String           @db.VarChar(6)
  ruleLevel       Int              @db.SmallInt
  /// Descrição da regra do Wazuh.
  title           String           @db.VarChar(500)
  eventName       String?          @db.VarChar(256)
  region          String?          @db.VarChar(64)
  resource        String?          @db.VarChar(2048)
  actorUser       String?          @db.VarChar(512)
  actorType       String?          @db.VarChar(64)
  accessKeyId     String?          @db.VarChar(128)
  sourceIp        String?          @db.VarChar(64)
  mitreTactics    String[]
  mitreTechniques String[]
  /// Exceção que marcou o achado como esperado na chegada (T3.5); o achado já nasce "legítimo".
  exceptionId     String?          @db.Uuid
  exception       AlertException?  @relation(fields: [exceptionId], references: [id], onDelete: SetNull)
  /// Incidente em que o achado entrou (T5.6); o sync agrupa, sempre dentro do mesmo cliente.
  incidentId      String?          @db.Uuid
  incident        Incident?        @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  /// Primeira vez que alguém tirou o achado de "novo" (relatório de tempo até a triagem).
  triagedAt       DateTime?        @db.Timestamptz(3)
  /// Só no GuardDuty: a versão do achado na origem (o `updatedAt` do GuardDuty, que só avança). Decide a reincidência:
  /// a versão mais nova de um achado já triado vira outro achado; a de um ainda não triado só avança esta data.
  lastSeenAt      DateTime?        @db.Timestamptz(3)
  /// Só no GuardDuty: a chave do achado inteiro na origem (`wazuh/<conta>/guardduty:<id>:<regra>`), a mesma no
  /// original, nas recorrências e, na sondagem de porta, no achado de cada IP. A cadeia da reincidência é lida por aqui.
  chainKey        String?          @db.VarChar(128)
  /// Achado original de que este é a recorrência (GuardDuty: atividade nova depois da triagem). A chave estrangeira
  /// inclui o cliente, então uma recorrência nunca aponta para achado de outro cliente.
  recurrenceOfId  String?          @db.Uuid
  recurrenceOf    Finding?         @relation("FindingRecurrence", fields: [recurrenceOfId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recurrences     Finding[]        @relation("FindingRecurrence")
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  comments        FindingComment[]
  notifications   Notification[]

  @@unique([source, sourceEventId])
  /// Alvo da chave composta dos comentários e das recorrências: só apontam para achado do mesmo cliente.
  @@unique([id, tenantId])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([incidentId])
  @@index([recurrenceOfId])
  @@index([tenantId, chainKey])
}

/// Comentário num achado (T5.5). Não é editado nem apagado (trigger na migration): é parte do registro da
/// decisão. A única exceção é o expurgo diário (fase 2, PR-19), que leva o comentário junto com o achado antigo, só
/// pela função `verax_purge_finding_comments` e só com mais de 30 dias. O papel da aplicação não tem DELETE.
/// A chave estrangeira inclui o cliente, então um comentário nunca aponta para achado de outro cliente.
model FindingComment {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  findingId String   @db.Uuid
  finding   Finding  @relation(fields: [findingId, tenantId], references: [id, tenantId], onDelete: Restrict)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([findingId, createdAt])
}

/// Motivo de um alerta ficar sem dono (T5.2).
enum UnownedReason {
  invalid_alert
  not_aws
  unknown_source
  ambiguous_source
  no_account
  conflicting_accounts
  unknown_account
  source_mismatch
  /// Alertas dos agentes do Wazuh nas instâncias do cliente: agentes desligados no worker do nó.
  agents_disabled
  /// O id do agente não está na lista do cliente do nó.
  unknown_agent
  /// O id do agente está na lista, com outro nome.
  agent_name_mismatch
  /// O alerta do agente cita uma conta AWS cadastrada em outro cliente.
  agent_account_conflict
}

/// Alerta que o sync não atribuiu a nenhum cliente (T5.2): na dúvida, o alerta não é de ninguém. Sem `tenantId`
/// de propósito; só `admin_verax` vê a fila. Guarda o mínimo para a triagem, nunca o evento bruto.
model UnownedAlert {
  id            String        @id @default(uuid(7)) @db.Uuid
  source        String        @db.VarChar(16)
  sourceEventId String        @db.VarChar(128)
  reason        UnownedReason
  /// Contas citadas no evento, quando o formato permitiu ler.
  accounts      String[]
  occurredAt    DateTime?     @db.Timestamptz(3)
  ruleId        String?       @db.VarChar(6)
  ruleLevel     Int?          @db.SmallInt
  title         String?       @db.VarChar(500)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([source, sourceEventId])
  @@index([createdAt(sort: Desc)])
}

/// Estado de uma sincronização (T5.3): até onde leu e a concessão que impede duas execuções ao mesmo tempo. A
/// concessão vence sozinha: um worker que morre no meio não trava o próximo.
model SyncState {
  name            String    @id @db.VarChar(32)
  /// Horário do alerta mais recente já processado; a próxima execução relê a partir dele, menos a sobreposição.
  lastProcessedAt DateTime? @db.Timestamptz(3)
  /// Continuação: quando uma execução bate o limite de páginas, a próxima segue deste cursor (horário e id), em vez
  /// de reler a sobreposição, que sozinha poderia ocupar todo o limite e travar a leitura.
  cursorTimestamp DateTime? @db.Timestamptz(3)
  cursorId        String?   @db.VarChar(128)
  lastRunAt       DateTime? @db.Timestamptz(3)
  lastSuccessAt   DateTime? @db.Timestamptz(3)
  /// Tipo do último erro, sem mensagem (que poderia carregar dado do indexer).
  lastError       String?   @db.VarChar(64)
  leaseOwner      String?   @db.VarChar(64)
  leaseUntil      DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
}

/// Prazo de histórico do expurgo diário (fase 2, PR-19; `src/retention/`), uma linha por tarefa (`id` é o nome dela no
/// `SyncState`, `retention`). O prazo vem do plano do nó; quando o plano diminui, o expurgo continua com o prazo
/// anterior por 30 dias (carência para exportar) e só então passa ao novo. Dado de sistema, sem `tenantId`: o prazo é
/// do nó, e o escopo do cliente recusa o model.
model RetentionState {
  id           String    @id @db.VarChar(32)
  /// Dias de histórico que o expurgo aplica; null é sem limite (plano interno).
  appliedDays  Int?
  /// Desde quando o plano pede um prazo menor que o aplicado; null sem redução pendente. A carência conta daqui.
  pendingSince DateTime? @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
}

enum IncidentStatus {
  open
  investigating
  resolved
}

/// Incidente (T5.6 e T5.7): achados do mesmo cliente com usuário, chave, IP ou recurso em comum, numa janela de
/// tempo. O sync abre e alimenta; pela API, mudam o status e o responsável. Os campos de resumo (severidade, nota,
/// período, chaves, contas, recursos e MITRE) são recalculados a cada achado novo.
model Incident {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @db.Uuid
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  severity        FindingSeverity
  status          IncidentStatus  @default(open)
  riskScore       Int             @db.SmallInt
  findingCount    Int
  firstSeenAt     DateTime        @db.Timestamptz(3)
  lastSeenAt      DateTime        @db.Timestamptz(3)
  keys            String[]
  accounts        String[]
  resources       String[]
  mitreTactics    String[]
  mitreTechniques String[]
  assigneeId      String?
  assignee        User?           @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Quando foi resolvido (relatório de tempo até a resolução); limpo se reaberto.
  resolvedAt      DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  findings        Finding[]
  notifications   Notification[]

  @@index([tenantId, status])
  @@index([tenantId, riskScore(sort: Desc)])
  /// Expurgo diário: incidentes sem atividade antes do corte.
  @@index([tenantId, lastSeenAt])
}

/// Uma varredura de postura (T5.8) de uma conta: a nota e as contagens. As checagens reprovadas ficam em
/// `PostureFailure`. Gravada pelo job que lê o relatório do Prowler.
model PostureScan {
  id                  String           @id @default(uuid(7)) @db.Uuid
  tenantId            String           @db.Uuid
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accountId           String           @db.VarChar(32)
  scannedAt           DateTime         @db.Timestamptz(3)
  /// De 0 a 100; null quando nenhuma checagem conta (só manuais ou silenciadas).
  score               Int?             @db.SmallInt
  /// Pesos aprovados e totais (crítica 10, alta 5, média 2, baixa 1): a nota do cliente soma os de todas as contas.
  weightPassed        Int
  weightTotal         Int
  passed              Int
  failed              Int
  failedCritical      Int
  failedHigh          Int
  failedMedium        Int
  failedLow           Int
  failedInformational Int
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  failures            PostureFailure[]

  @@unique([tenantId, accountId, scannedAt])
  /// Alvo da chave composta das reprovações: a reprovação é sempre do mesmo cliente da varredura.
  @@unique([id, tenantId])
  @@index([tenantId, accountId, scannedAt(sort: Desc)])
}

enum PostureSeverity {
  critical
  high
  medium
  low
  informational
}

/// Checagem reprovada numa varredura de postura.
model PostureFailure {
  id           String          @id @default(uuid(7)) @db.Uuid
  tenantId     String          @db.Uuid
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  scanId       String          @db.Uuid
  scan         PostureScan     @relation(fields: [scanId, tenantId], references: [id, tenantId], onDelete: Cascade)
  /// Id estável da reprovação no relatório (checagem + recurso).
  findingUid   String          @db.VarChar(512)
  checkId      String          @db.VarChar(160)
  title        String          @db.VarChar(500)
  severity     PostureSeverity
  region       String          @db.VarChar(40)
  resource     String?         @db.VarChar(4000)
  resourceType String?         @db.VarChar(4000)
  risk         String?         @db.VarChar(4000)
  remediation  String?         @db.VarChar(4000)
  references   String[]

  @@unique([scanId, findingUid])
  @@index([tenantId, scanId])
}

/// Retrato do inventário de uma conta (T5.9): os itens de cada tipo, já com o risco, como JSON validado pelo
/// contrato compartilhado ao gravar e ao ler. Gravado pela tarefa `aws-inventory` do worker (fase 2, PR-14',
/// `src/inventory/inventory-job.ts`); o mais recente de cada conta vale. `collectedAt` é o início da coleta, e a
/// chave única com ele torna a gravação idempotente.
model InventorySnapshot {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accountId   String   @db.VarChar(32)
  collectedAt DateTime @db.Timestamptz(3)
  /// Conta root (MFA e chaves) com o risco.
  root        Json?
  /// Itens por tipo: `users`, `keys`, `instances`, `buckets`, `security-groups`.
  items       Json
  /// Coleta parcial (PR-14'): as partes que não entraram, `parte:código` ou `parte:região:código`
  /// (`ec2:sa-east-1:UnauthorizedOperation`, `iam:invalid_items`), só o nome do erro da AWS, nunca a mensagem. Vazio
  /// numa coleta completa.
  errors      String[] @default([])
  /// Alguma parte passou do teto de itens por tipo (1.000): os itens além dele não estão no retrato.
  truncated   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, accountId, collectedAt])
  @@index([tenantId, accountId, collectedAt(sort: Desc)])
}

/// Volume de log lido por cliente, mês e fonte (fase 2, PR-03): a medida dos GiB por mês do plano. Gravado pelo
/// `UsageMeter` dos coletores, sempre depois da confirmação da leitura (o lote que falha antes não conta). A regra é
/// uma só: os bytes UTF-8 de cada registro como a fonte entrega, já descompactado, contando todos os registros lidos,
/// inclusive os que nenhuma regra acusa. Uma reentrega da fonte pode contar duas vezes ("uso justo").
model IngestUsage {
  tenantId String   @db.Uuid
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// Primeiro dia do mês no calendário de Brasília (a virada é às 03:00 UTC).
  month    DateTime @db.Date
  /// Fonte do volume: `gcp` (Pub/Sub), `aws` (Wazuh) ou `cloudflare`.
  source   String   @db.VarChar(16)
  bytes    BigInt
  events   BigInt

  @@id([tenantId, month, source])
}

/// Tipo da credencial guardada no cofre do nó: o token só de leitura do Cloudflare. A chave de acesso da AWS
/// (`aws_access_key`, do PR-V1) saiu no PR-V3': a AWS é lida pelo papel sem chave.
enum CloudCredentialKind {
  cloudflare_api_token
}

/// Credencial de leitura de uma conta cloud, cifrada no cofre do nó (fase 2, PR-V1; `src/credentials/`). Uma por
/// conta. O texto cifrado é RSA-OAEP-SHA256 com a chave pública do nó: a API cifra e não decifra; só o worker tem a
/// chave privada. O rótulo do OAEP amarra o texto ao cliente, à conta e ao tipo, então uma linha copiada para outra
/// conta ou outro cliente não abre. O segredo nunca sai pela API nem vai para a auditoria (só `keyIdSuffix`). A
/// migration confere por CHECK o formato do envelope, a versão e o sufixo.
model CloudCredential {
  cloudAccountId   String              @id @db.Uuid
  /// Chave estrangeira composta (conta e cliente): o banco recusa a credencial de um cliente na conta de outro.
  cloudAccount     CloudAccount        @relation(fields: [cloudAccountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenantId         String              @db.Uuid
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  kind             CloudCredentialKind
  /// `v<keyVersion>:<base64>`: o envelope do cofre, com a versão da chave do nó que cifrou.
  ciphertext       String              @db.VarChar(1024)
  /// Versão da chave do nó (a versão do segredo `credentials-key` no Secret Manager). A tarefa `credential-rekey` do
  /// worker recifra as linhas de versões antigas com a corrente.
  keyVersion       Int
  /// Os 4 últimos caracteres do ID do token: o que o painel e a auditoria mostram.
  keyIdSuffix      String              @db.VarChar(4)
  /// Criação do token na origem, quando ela informa: a idade conta daqui.
  issuedAt         DateTime?           @db.Timestamptz(3)
  /// Validade do token do Cloudflare, quando ele tem uma.
  expiresAt        DateTime?           @db.Timestamptz(3)
  /// Última validação bem-sucedida na fonte (`tokens/verify`).
  verifiedAt       DateTime            @db.Timestamptz(3)
  /// Quando saiu o aviso de troca da chave (rotação).
  rotationNoticeAt DateTime?           @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  /// Exigido pelo Prisma na relação um para um com chave composta (o `cloudAccountId` sozinho já é único).
  @@unique([cloudAccountId, tenantId])
  @@index([tenantId])
}

/// Estado do agente do Wazuh, como o manager do nó informa.
enum WazuhAgentStatus {
  active
  disconnected
  pending
  never_connected
}

/// Agente do Wazuh numa instância do cliente (agentes nas instâncias, desligado por padrão em cada nó). O worker grava
/// a lista que o host exporta da API do manager a cada minuto, no cliente do nó (WAZUH_AGENTS_TENANT); o painel só lê.
/// O id do agente é o do manager do nó, único no nó. Tudo vem da instância do cliente: entrada não confiável, validada
/// pelo worker antes de gravar.
model WazuhAgent {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @db.Uuid
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agentId         String           @db.VarChar(8)
  name            String           @db.VarChar(128)
  /// IP de onde o agente fala com o manager (`any` antes da primeira conexão).
  ip              String?          @db.VarChar(64)
  osName          String?          @db.VarChar(128)
  osVersion       String?          @db.VarChar(64)
  osPlatform      String?          @db.VarChar(32)
  version         String?          @db.VarChar(32)
  status          WazuhAgentStatus
  lastKeepAliveAt DateTime?        @db.Timestamptz(3)
  registeredAt    DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([agentId])
  @@index([tenantId, name])
}

/// Tipo do aviso por e-mail (fase 2, PR-16). `aws_ingestion_stalled` já existe para a tarefa do medidor da AWS (PR-V6),
/// que ainda não o emite.
enum NotificationKind {
  incident_opened
  incident_escalated
  critical_finding
  aws_ingestion_stalled
  plan_usage
}

/// Estado do aviso na fila de saída: `skipped` é o que não sai (nó sem e-mail, ninguém para receber, aviso de 80%
/// coberto pelo de 100%); `failed`, o que falhou em todas as tentativas.
enum NotificationStatus {
  pending
  sent
  failed
  skipped
}

/// Aviso por e-mail na fila de saída (outbox; fase 2, PR-16). Nasce na mesma transação do fato que o gera (o achado e o
/// incidente, em `FindingStore`; o volume do mês, na tarefa `notifications`) e o worker entrega
/// (`notifications/notification-dispatcher.ts`). A chave de deduplicação, única por cliente, faz o mesmo fato gerar um
/// aviso só, por mais que seja relido. Os destinatários não ficam aqui: são resolvidos no envio, e só o id de quem já
/// recebeu fica guardado (a nova tentativa não repete o e-mail). Nenhum endereço de e-mail é gravado.
model Notification {
  id               String             @id @default(uuid(7)) @db.Uuid
  tenantId         String             @db.Uuid
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  kind             NotificationKind
  /// `incident:<id>:<severidade>`, `finding:<id>` ou `usage:<AAAA-MM>:<80|100>`.
  dedupeKey        String             @db.VarChar(128)
  /// Severidade que gerou o aviso (o incidente ao abrir ou ao subir, o achado crítico).
  severity         FindingSeverity?
  /// Incidente do aviso; um gatilho no banco confere que é do mesmo cliente. Apagar o incidente apaga o aviso.
  incidentId       String?            @db.Uuid
  incident         Incident?          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  /// Achado crítico fora de incidente. A chave estrangeira inclui o cliente.
  findingId        String?            @db.Uuid
  finding          Finding?           @relation(fields: [findingId, tenantId], references: [id, tenantId], onDelete: Cascade)
  /// Volume do plano: o mês (primeiro dia, calendário de Brasília) e a faixa alcançada (80 ou 100).
  usageMonth       DateTime?          @db.Date
  usagePercent     Int?               @db.SmallInt
  status           NotificationStatus @default(pending)
  /// Tentativas de envio feitas (no máximo 5; recuo de 1, 5, 15 e 60 min entre elas).
  attempts         Int                @default(0) @db.SmallInt
  nextAttemptAt    DateTime           @default(now()) @db.Timestamptz(3)
  /// Tipo do último erro do envio, ou o motivo de `skipped` (`mail_disabled`, `no_recipients`, `superseded`). Nunca a
  /// mensagem do servidor, que pode citar o endereço.
  lastError        String?            @db.VarChar(64)
  /// Usuários que já receberam este aviso (o id, nunca o e-mail).
  deliveredUserIds String[]           @default([])
  sentAt           DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([incidentId])
  @@index([findingId])
}
