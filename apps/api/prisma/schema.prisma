// Schema do banco da API (PostgreSQL 18).
// A URL de conexão fica em prisma.config.ts (Prisma 7) e vem sempre do ambiente, nunca do código.
// Modelos com dado de cliente terão `tenantId` e entram na extensão de isolamento (T2.5).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Quem executou a ação registrada na auditoria.
enum AuditActorType {
  user
  system
  anonymous
}

/// Resultado da operação auditada.
enum AuditOutcome {
  success
  failure
  denied
}

/// Trilha de auditoria imutável (T1.3): só INSERT. Um trigger no banco bloqueia UPDATE, DELETE e TRUNCATE.
/// Os IDs de ator e cliente não têm chave estrangeira de propósito: o registro sobrevive à exclusão do
/// usuário ou do cliente.
model AuditLog {
  id           String         @id @default(uuid(7)) @db.Uuid
  occurredAt   DateTime       @default(now()) @db.Timestamptz(3)
  actorType    AuditActorType
  actorId      String?
  tenantId     String?
  action       String         @db.VarChar(200)
  resourceType String?        @db.VarChar(100)
  resourceId   String?        @db.VarChar(200)
  outcome      AuditOutcome
  statusCode   Int?           @db.SmallInt
  before       Json?
  after        Json?
  ip           String?        @db.VarChar(64)
  userAgent    String?        @db.VarChar(256)
  requestId    String?        @db.VarChar(64)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@index([requestId])
}

/// Papéis do painel (T2.4). `admin_verax` é da Verax e não pertence a cliente; os demais pertencem a um.
enum UserRole {
  admin_verax
  admin_cliente
  analista_cliente
  leitura
}

/// Usuário só entra por convite (T2.6): nasce `invited`, vira `active` ao definir a senha.
enum UserStatus {
  invited
  active
  disabled
}

enum TenantStatus {
  active
  inactive
}

/// Cliente da Verax (T3.1). CNPJ, plano e contato são obrigatórios na API; ficam opcionais no banco só por
/// causa dos clientes criados antes do cadastro completo.
model Tenant {
  id                 String              @id @default(uuid(7)) @db.Uuid
  name               String              @db.VarChar(120)
  /// 14 caracteres, sem máscara (numérico ou alfanumérico).
  cnpj               String?             @unique @db.VarChar(14)
  plan               String?             @db.VarChar(60)
  escalationName     String?             @db.VarChar(120)
  escalationEmail    String?             @db.VarChar(254)
  escalationPhone    String?             @db.VarChar(20)
  status             TenantStatus        @default(active)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  users              User[]
  cloudAccounts      CloudAccount[]
  protectedResources ProtectedResource[]
  alertExceptions    AlertException[]
  findings           Finding[]
  findingComments    FindingComment[]
  incidents          Incident[]
  postureScans       PostureScan[]
  postureFailures    PostureFailure[]
  inventorySnapshots InventorySnapshot[]
  /// Sessões de admin_verax com este cliente selecionado (T2.5).
  activeSessions     Session[]
}

// ---------------------------------------------------------------------------------------------------
// Tabelas do Better Auth (T2.1). Nomes e campos seguem o que a biblioteca espera; `role`, `tenantId` e
// `status` são campos adicionais que o usuário não consegue alterar pela API de autenticação.
// ---------------------------------------------------------------------------------------------------

model User {
  id                 String              @id
  name               String              @db.VarChar(120)
  email              String              @unique @db.VarChar(254)
  emailVerified      Boolean             @default(false)
  image              String?
  role               UserRole
  tenantId           String?             @db.Uuid
  tenant             Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  status             UserStatus          @default(invited)
  /// MFA (T2.2): sem ele, a sessão só alcança o cadastro do próprio MFA.
  twoFactorEnabled   Boolean             @default(false)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  accounts           Account[]
  twoFactors         TwoFactor[]
  usedTotpCodes      UsedTotpCode[]
  protectedResources ProtectedResource[]
  alertExceptions    AlertException[]
  findingComments    FindingComment[]
  assignedIncidents  Incident[]

  @@index([tenantId])
}

model Session {
  id             String   @id
  token          String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime @db.Timestamptz(3)
  ipAddress      String?  @db.VarChar(64)
  userAgent      String?  @db.VarChar(512)
  /// Cliente selecionado por um admin_verax (T2.5). Só muda por POST /v1/session/tenant, auditado.
  activeTenantId String?  @db.Uuid
  activeTenant   Tenant?  @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  /// Hash da senha (scrypt, gerado pelo Better Auth). Nunca a senha em si.
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

/// Tokens de convite e de redefinição de senha, guardados com hash (`storeIdentifier: "hashed"`).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

/// TOTP e códigos de recuperação (T2.2). O segredo e os códigos ficam cifrados com a chave do Better Auth.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
}

/// Limite de requisições por IP das rotas de autenticação (T2.3), no banco para valer entre instâncias.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

/// Tentativas de login por e-mail que ainda não terminaram numa sessão completa (T2.3). Vale também para
/// e-mail inexistente, para não revelar quem existe.
model LoginAttempt {
  email          String    @id @db.VarChar(254)
  failures       Int
  firstFailureAt DateTime  @db.Timestamptz(3)
  lockedUntil    DateTime? @db.Timestamptz(3)
}

/// Códigos TOTP aceitos em login nos últimos minutos (T2.2): o mesmo código não abre uma segunda sessão.
model UsedTotpCode {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code   String   @db.VarChar(16)
  usedAt DateTime @db.Timestamptz(3)

  @@id([userId, code])
}

enum CloudAccountStatus {
  active
  inactive
}

enum CloudProvider {
  aws
  gcp
  cloudflare
}

/// Conta cloud de um cliente (T3.3): conta AWS, projeto da GCP ou conta do Cloudflare. Nenhuma credencial é
/// guardada: na AWS, a Verax assume o papel de leitura `VeraxControlReadOnly` com o ExternalId, gerado aqui; na
/// GCP, o nó lê com a identidade dele, sem chave; o token do Cloudflare fica no cofre de segredos do nó. Cada
/// conta pertence a um só cliente. A migration garante, por CHECK, que toda conta AWS tem ExternalId.
model CloudAccount {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @db.Uuid
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  provider           CloudProvider      @default(aws)
  /// 12 dígitos (AWS), ID do projeto (GCP, até 30) ou 32 hexadecimais (Cloudflare).
  accountId          String             @db.VarChar(32)
  /// AWS: regiões monitoradas.
  regions            String[]
  /// AWS: ExternalId do papel de leitura.
  externalId         String?            @db.VarChar(128)
  /// AWS: buckets de onde o Wazuh lê os logs desta conta (T5.2 vincula cada alerta pelo bucket de origem).
  cloudtrailBucket   String?            @db.VarChar(63)
  guarddutyBucket    String?            @db.VarChar(63)
  wafBucket          String?            @db.VarChar(63)
  /// GCP: assinatura do Pub/Sub que o nó lê, pelo nome completo (`projects/<projeto>/subscriptions/<id>`).
  pubsubSubscription String?            @db.VarChar(320)
  /// Cloudflare: zonas (domínios) monitoradas.
  zones              String[]           @default([])
  /// Horário do alerta mais recente desta conta, gravado pelo sync (T5.3).
  lastEventAt        DateTime?          @db.Timestamptz(3)
  status             CloudAccountStatus @default(active)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([provider, accountId])
  @@index([tenantId])
}

enum ProtectedResourceType {
  aws_account
  iam_user
  iam_role
  access_key
  ec2_instance
  s3_bucket
  security_group
  ip_address
}

/// Lista de proteção (T3.4): recursos e identidades que nunca recebem ação automática.
model ProtectedResource {
  id          String                @id @default(uuid(7)) @db.Uuid
  tenantId    String                @db.Uuid
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  type        ProtectedResourceType
  identifier  String                @db.VarChar(600)
  reason      String                @db.VarChar(500)
  createdById String
  createdBy   User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, type, identifier])
}

enum AlertExceptionField {
  user
  ip
  resource
}

/// Exceção de alerta (T3.5): o sync marca como esperado o achado da regra cujo campo bate com o valor.
model AlertException {
  id            String              @id @default(uuid(7)) @db.Uuid
  tenantId      String              @db.Uuid
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ruleId        String              @db.VarChar(6)
  field         AlertExceptionField
  value         String              @db.VarChar(256)
  reason        String              @db.VarChar(500)
  expiresAt     DateTime?           @db.Timestamptz(3)
  /// Quantas vezes a exceção marcou um achado como esperado (atualizado pelo sync, T5.3).
  matchedCount  Int                 @default(0)
  lastMatchedAt DateTime?           @db.Timestamptz(3)
  createdById   String
  createdBy     User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)
  findings      Finding[]

  @@unique([tenantId, ruleId, field, value])
}

enum FindingSeverity {
  critical
  high
  medium
  low
}

enum FindingStatus {
  new
  investigating
  legitimate
  resolved
}

/// Achado (T5.3 a T5.5): alerta do Wazuh já vinculado a um cliente pela T5.2. Aqui ficam os campos que o painel
/// mostra e os estados humanos (status e comentários); o evento bruto continua no indexer e só vem no detalhe.
/// `(source, sourceEventId)` é único: o sync relê uma janela de sobreposição sem duplicar achados.
model Finding {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @db.Uuid
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// Conta do provedor de onde veio o evento (12 dígitos, ID do projeto ou ID do Cloudflare).
  accountId       String           @db.VarChar(32)
  /// Sistema de origem do alerta (`wazuh`).
  source          String           @db.VarChar(16)
  /// ID do alerta no sistema de origem.
  sourceEventId   String           @db.VarChar(128)
  /// Fonte de log: `cloudtrail`, `guardduty`, `waf`.
  logSource       String           @db.VarChar(32)
  occurredAt      DateTime         @db.Timestamptz(3)
  severity        FindingSeverity
  status          FindingStatus    @default(new)
  ruleId          String           @db.VarChar(6)
  ruleLevel       Int              @db.SmallInt
  /// Descrição da regra do Wazuh.
  title           String           @db.VarChar(500)
  eventName       String?          @db.VarChar(256)
  region          String?          @db.VarChar(64)
  resource        String?          @db.VarChar(2048)
  actorUser       String?          @db.VarChar(512)
  actorType       String?          @db.VarChar(64)
  accessKeyId     String?          @db.VarChar(128)
  sourceIp        String?          @db.VarChar(64)
  mitreTactics    String[]
  mitreTechniques String[]
  /// Exceção que marcou o achado como esperado na chegada (T3.5); o achado já nasce "legítimo".
  exceptionId     String?          @db.Uuid
  exception       AlertException?  @relation(fields: [exceptionId], references: [id], onDelete: SetNull)
  /// Incidente em que o achado entrou (T5.6); o sync agrupa, sempre dentro do mesmo cliente.
  incidentId      String?          @db.Uuid
  incident        Incident?        @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  /// Primeira vez que alguém tirou o achado de "novo" (relatório de tempo até a triagem).
  triagedAt       DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  comments        FindingComment[]

  @@unique([source, sourceEventId])
  /// Alvo da chave composta dos comentários: o comentário só aponta para achado do mesmo cliente.
  @@unique([id, tenantId])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([incidentId])
}

/// Comentário num achado (T5.5). Não é editado nem apagado (trigger na migration): é parte do registro da
/// decisão. A chave estrangeira inclui o cliente, então um comentário nunca aponta para achado de outro cliente.
model FindingComment {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  findingId String   @db.Uuid
  finding   Finding  @relation(fields: [findingId, tenantId], references: [id, tenantId], onDelete: Restrict)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([findingId, createdAt])
}

/// Motivo de um alerta ficar sem dono (T5.2).
enum UnownedReason {
  invalid_alert
  not_aws
  unknown_source
  ambiguous_source
  no_account
  conflicting_accounts
  unknown_account
  source_mismatch
}

/// Alerta que o sync não atribuiu a nenhum cliente (T5.2): na dúvida, o alerta não é de ninguém. Sem `tenantId`
/// de propósito; só `admin_verax` vê a fila. Guarda o mínimo para a triagem, nunca o evento bruto.
model UnownedAlert {
  id            String        @id @default(uuid(7)) @db.Uuid
  source        String        @db.VarChar(16)
  sourceEventId String        @db.VarChar(128)
  reason        UnownedReason
  /// Contas citadas no evento, quando o formato permitiu ler.
  accounts      String[]
  occurredAt    DateTime?     @db.Timestamptz(3)
  ruleId        String?       @db.VarChar(6)
  ruleLevel     Int?          @db.SmallInt
  title         String?       @db.VarChar(500)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([source, sourceEventId])
  @@index([createdAt(sort: Desc)])
}

/// Estado de uma sincronização (T5.3): até onde leu e a concessão que impede duas execuções ao mesmo tempo. A
/// concessão vence sozinha: um worker que morre no meio não trava o próximo.
model SyncState {
  name            String    @id @db.VarChar(32)
  /// Horário do alerta mais recente já processado; a próxima execução relê a partir dele, menos a sobreposição.
  lastProcessedAt DateTime? @db.Timestamptz(3)
  /// Continuação: quando uma execução bate o limite de páginas, a próxima segue deste cursor (horário e id), em vez
  /// de reler a sobreposição, que sozinha poderia ocupar todo o limite e travar a leitura.
  cursorTimestamp DateTime? @db.Timestamptz(3)
  cursorId        String?   @db.VarChar(128)
  lastRunAt       DateTime? @db.Timestamptz(3)
  lastSuccessAt   DateTime? @db.Timestamptz(3)
  /// Tipo do último erro, sem mensagem (que poderia carregar dado do indexer).
  lastError       String?   @db.VarChar(64)
  leaseOwner      String?   @db.VarChar(64)
  leaseUntil      DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
}

enum IncidentStatus {
  open
  investigating
  resolved
}

/// Incidente (T5.6 e T5.7): achados do mesmo cliente com usuário, chave, IP ou recurso em comum, numa janela de
/// tempo. O sync abre e alimenta; pela API, mudam o status e o responsável. Os campos de resumo (severidade, nota,
/// período, chaves, contas, recursos e MITRE) são recalculados a cada achado novo.
model Incident {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @db.Uuid
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  severity        FindingSeverity
  status          IncidentStatus  @default(open)
  riskScore       Int             @db.SmallInt
  findingCount    Int
  firstSeenAt     DateTime        @db.Timestamptz(3)
  lastSeenAt      DateTime        @db.Timestamptz(3)
  keys            String[]
  accounts        String[]
  resources       String[]
  mitreTactics    String[]
  mitreTechniques String[]
  assigneeId      String?
  assignee        User?           @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Quando foi resolvido (relatório de tempo até a resolução); limpo se reaberto.
  resolvedAt      DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  findings        Finding[]

  @@index([tenantId, status])
  @@index([tenantId, riskScore(sort: Desc)])
}

/// Uma varredura de postura (T5.8) de uma conta: a nota e as contagens. As checagens reprovadas ficam em
/// `PostureFailure`. Gravada pelo job que lê o relatório do Prowler.
model PostureScan {
  id                  String           @id @default(uuid(7)) @db.Uuid
  tenantId            String           @db.Uuid
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accountId           String           @db.VarChar(32)
  scannedAt           DateTime         @db.Timestamptz(3)
  /// De 0 a 100; null quando nenhuma checagem conta (só manuais ou silenciadas).
  score               Int?             @db.SmallInt
  /// Pesos aprovados e totais (crítica 10, alta 5, média 2, baixa 1): a nota do cliente soma os de todas as contas.
  weightPassed        Int
  weightTotal         Int
  passed              Int
  failed              Int
  failedCritical      Int
  failedHigh          Int
  failedMedium        Int
  failedLow           Int
  failedInformational Int
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  failures            PostureFailure[]

  @@unique([tenantId, accountId, scannedAt])
  /// Alvo da chave composta das reprovações: a reprovação é sempre do mesmo cliente da varredura.
  @@unique([id, tenantId])
  @@index([tenantId, accountId, scannedAt(sort: Desc)])
}

enum PostureSeverity {
  critical
  high
  medium
  low
  informational
}

/// Checagem reprovada numa varredura de postura.
model PostureFailure {
  id           String          @id @default(uuid(7)) @db.Uuid
  tenantId     String          @db.Uuid
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  scanId       String          @db.Uuid
  scan         PostureScan     @relation(fields: [scanId, tenantId], references: [id, tenantId], onDelete: Cascade)
  /// Id estável da reprovação no relatório (checagem + recurso).
  findingUid   String          @db.VarChar(512)
  checkId      String          @db.VarChar(160)
  title        String          @db.VarChar(500)
  severity     PostureSeverity
  region       String          @db.VarChar(40)
  resource     String?         @db.VarChar(4000)
  resourceType String?         @db.VarChar(4000)
  risk         String?         @db.VarChar(4000)
  remediation  String?         @db.VarChar(4000)
  references   String[]

  @@unique([scanId, findingUid])
  @@index([tenantId, scanId])
}

/// Retrato do inventário de uma conta (T5.9): os itens de cada tipo, já com o risco, como JSON validado pelo
/// contrato compartilhado ao gravar e ao ler. Gravado pelo job de inventário; o mais recente de cada conta vale.
model InventorySnapshot {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accountId   String   @db.VarChar(32)
  collectedAt DateTime @db.Timestamptz(3)
  /// Conta root (MFA e chaves) com o risco.
  root        Json?
  /// Itens por tipo: `users`, `keys`, `instances`, `buckets`, `security-groups`.
  items       Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, accountId, collectedAt])
  @@index([tenantId, accountId, collectedAt(sort: Desc)])
}
