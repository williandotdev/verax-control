{
  "name": "verax-control",
  "version": "0.0.0",
  "private": true,
  "description": "Verax Control: painel de segurança para empresas com operação em nuvem",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=11.1.0"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "predev": "pnpm --filter @verax/shared build",
    "dev": "pnpm --recursive --parallel --stream dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test && pnpm test:lint-rules",
    "test:lint-rules": "node scripts/verify-lint-rules.mjs",
    "prelint": "pnpm --filter @verax/shared build && pnpm --filter @verax/api db:generate",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "pnpm --filter @verax/shared build",
    "typecheck": "pnpm --recursive typecheck",
    "setup:env": "node scripts/setup-env.mjs",
    "db:migrate": "pnpm --filter @verax/api db:migrate",
    "db:deploy": "pnpm --filter @verax/api db:deploy",
    "db:seed": "pnpm --filter @verax/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.13.0",
    "lefthook": "2.2.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
