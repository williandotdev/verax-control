{
  "name": "Proteção da main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "required_signatures"
    },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": ["squash"],
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_extra_approval_for_unattributed_changes": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true,
        "required_reviewers": []
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Lint, formatação e tipos",
            "integration_id": 15368
          },
          {
            "context": "Testes",
            "integration_id": 15368
          },
          {
            "context": "Build",
            "integration_id": 15368
          },
          {
            "context": "Testes de navegador",
            "integration_id": 15368
          },
          {
            "context": "Semgrep (SAST)",
            "integration_id": 15368
          },
          {
            "context": "Gitleaks (segredos no histórico)",
            "integration_id": 15368
          },
          {
            "context": "Trivy (dependências, segredos e configuração)",
            "integration_id": 15368
          },
          {
            "context": "OSV-Scanner (vulnerabilidades em dependências)",
            "integration_id": 15368
          },
          {
            "context": "CodeQL (javascript-typescript)",
            "integration_id": 15368
          },
          {
            "context": "CodeQL (actions)",
            "integration_id": 15368
          },
          {
            "context": "Dependency Review",
            "integration_id": 15368
          },
          {
            "context": "Workflows (actionlint + zizmor)",
            "integration_id": 15368
          },
          {
            "context": "Imagem da API (build, Trivy e teste como em produção)",
            "integration_id": 15368
          },
          {
            "context": "Terraform (formatação, validação e lint)",
            "integration_id": 15368
          },
          {
            "context": "Wazuh (scripts, compose e teste de ponta a ponta)",
            "integration_id": 15368
          },
          {
            "context": "Prowler (entrypoint e imagem)",
            "integration_id": 15368
          },
          {
            "context": "CloudFormation (cfn-lint e testes do conector)",
            "integration_id": 15368
          },
          {
            "context": "Checkov (políticas de segurança da infra)",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
