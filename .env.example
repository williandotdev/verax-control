# Copie para .env com `pnpm setup:env`, que gera os segredos automaticamente.
# Nunca versione o .env. Valores marcados com __GENERATE__ são substituídos por segredos aleatórios.

# --- Ambiente ---
NODE_ENV=development
LOG_LEVEL=info

# --- API ---
PORT=3000
# Proxies confiáveis na frente da API. Local: 0 (X-Forwarded-For ignorado). Atrás do ALB: 1.
TRUST_PROXY_HOPS=0
# Origem pública do painel (CORS, CSRF e cookies). Em produção, sempre https.
WEB_ORIGIN=http://localhost:5173
# Origem pública da API (base das URLs do Better Auth). Em produção, sempre https.
API_ORIGIN=http://localhost:3000

# --- Autenticação ---
# Chave do Better Auth: assina cookies de sessão e cifra o segredo do TOTP. Em produção vem do Secrets Manager.
BETTER_AUTH_SECRET=__GENERATE__
# Chave dos tokens CSRF. Em produção vem do Secrets Manager.
CSRF_SECRET=__GENERATE__
# Limite de tentativas por IP na autenticação. Obrigatório em produção.
AUTH_RATE_LIMIT_ENABLED=true

# --- Seed de desenvolvimento (pnpm db:seed). Nunca roda em produção. ---
# A senha do admin fica só neste arquivo local; troque-a se quiser uma memorizável (mínimo 12 caracteres).
SEED_ADMIN_EMAIL=admin@verax.local
SEED_ADMIN_PASSWORD=__GENERATE__

# --- PostgreSQL local (docker-compose) ---
POSTGRES_USER=verax
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=verax
POSTGRES_PORT=5432
DATABASE_URL=postgresql://verax:${POSTGRES_PASSWORD}@localhost:5432/verax
TEST_DATABASE_URL=postgresql://verax:${POSTGRES_PASSWORD}@localhost:5432/verax_test
