# Lista de permissão: só entra no contexto de build o que as imagens da API (apps/api/Dockerfile) e do plano de
# controle (apps/control-plane/Dockerfile, com as telas do console do responsável, apps/console) precisam. Tudo o
# mais fica de fora, inclusive .env, chaves e node_modules locais.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!packages/shared/package.json
!packages/shared/tsconfig*.json
!packages/shared/src
!apps/api/package.json
!apps/api/tsconfig*.json
!apps/api/nest-cli.json
!apps/api/prisma.config.ts
!apps/api/prisma
!apps/api/src
!apps/control-plane/package.json
!apps/control-plane/tsconfig*.json
!apps/control-plane/nest-cli.json
!apps/control-plane/src
!apps/console/package.json
!apps/console/tsconfig*.json
!apps/console/vite.config.ts
!apps/console/index.html
!apps/console/public
!apps/console/src
!scripts/scan-bundle.mjs
!tsconfig.base.json

# Mesmo dentro das pastas permitidas.
**/node_modules
**/dist
**/generated
**/.env*
**/*.pem
**/*.key
